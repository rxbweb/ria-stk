            span.button__icon
               svg(class=`svg-${iconClass}` width="22" height="22")
                  use(xlink:href=`images/sprites/main.stack.svg#svg-${iconClass}`)

mixin button(text = 'Кнопка', className = '', iconClass = '', isLink = true, href = '#', isDiv = false)
   if isLink
      a.button(class=className href=href)
         if text
            span= text
         if iconClass
            span.button__icon
               svg(class=`svg-${iconClass}` width="22" height="22")
                  use(xlink:href=`images/sprites/main.stack.svg#svg-${iconClass}`)
   else if isDiv
      div.button(class=className)
         if text
            span= text
         if iconClass
            span.button__icon
               svg(class=`svg-${iconClass}` width="22" height="22")
                  use(xlink:href=`images/sprites/main.stack.svg#svg-${iconClass}`)
   else
      button.button(class=className)
         if text
            span= text
         if iconClass
            span.button__icon
               svg(class=`svg-${iconClass}` width="22" height="22")
                  use(xlink:href=`images/sprites/main.stack.svg#svg-${iconClass}`)

