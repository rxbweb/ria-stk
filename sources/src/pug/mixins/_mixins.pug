mixin breadcrumbs(items, extraClass)
   .breadcrumbs(class=extraClass)
      .breadcrumbs__inner.container
         .breadcrumbs__list
            each item, index in items
               if index === items.length - 1
                  span= item.title
               else
                  a(href=item.href)= item.title

mixin button-icon(type = 'link', text = 'Кнопка', className = '', iconClass = 'icon-arrow-right', iconWidth = '17', iconHeight = '17')
   if type === 'button'
      button.button(class=className)
         if text
            span= text
         if iconClass
            span.button__icon
               svg(class=`svg-${iconClass}` width=iconWidth height=iconHeight)
                  use(xlink:href=`images/sprites/main.stack.svg#svg-${iconClass}`)
   else if type === 'button-disabled'
      button.button(class=className disabled)
         if text
            span= text
         if iconClass
            span.button__icon
               svg(class=`svg-${iconClass}` width=iconWidth height=iconHeight)
                  use(xlink:href=`images/sprites/main.stack.svg#svg-${iconClass}`)
   else if type === 'div'
      .button(class=className)
         if text
            span= text
         if iconClass
            span.button__icon
               svg(class=`svg-${iconClass}` width=iconWidth height=iconHeight)
                  use(xlink:href=`images/sprites/main.stack.svg#svg-${iconClass}`)
   else
      a.button(class=className href="#")
         if text
            span= text
         if iconClass
            span.button__icon
               svg(class=`svg-${iconClass}` width=iconWidth height=iconHeight)
                  use(xlink:href=`images/sprites/main.stack.svg#svg-${iconClass}`)

mixin button-loading(type = 'link', text = 'Кнопка', className = '', iconClass = '', attr)
   if type === 'link'
      a.button(class=className href=href data-loading=attr)
