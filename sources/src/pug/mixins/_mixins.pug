mixin picture(img, mob = false, title = 'картинка', width = 'auto', height = 'auto')
   - const imgBase = img.replace(/\.(png|jpg|jpeg|webp)$/i, '')

   picture
      if mob
         - const mobBase = mob.replace(/\.(png|jpg|jpeg|webp)$/i, '')
         source(srcset=mobBase + ".webp" media="(max-width: 575px)" type="image/webp")
         source(srcset=mob media="(max-width: 575px)")

      source(srcset=imgBase + ".webp")
      img(src=img alt=title width=width height=height)

mixin swiperControls(className = '', prevClass = '', nextClass = '', paginationClass = '')
   .swiper-controls(class=className)
      button.swiper-button-prev(class=prevClass aria-label="Переключиться на предыдущий слайд")
      .swiper-pagination(class=paginationClass aria-label="Пагинация слайдера")
      button.swiper-button-next(class=nextClass aria-label="Переключиться на следующий слайд")

mixin agree(title = 'Кнопка', className = '', name = '', required = false)
   .agree(class=className)
      label.agree__label
         input(
            type="checkbox"
            name=name != '' ? name : false
            required=required ? true : false
         )
         span.agree__checkbox
         span.agree__text= title

mixin svg(name, className = '', width = 26, height = 26)
   svg(width=width height=height, class=className)
      use(xlink:href=`images/sprites/main.stack.svg#svg-${name}`)

mixin favorite-button(className = '', type = 'button', ariaLabel = 'добавить этот продукт в избранное')
   if type === 'button'
      button.favorite-button(class=className, aria-label=ariaLabel)
         +svg('icon-heart', '', 32, 30)
   else
      a.favorite-button(class=className, href='#')
