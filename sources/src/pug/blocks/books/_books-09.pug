-
   const books09 = [
      { 
         src: 'images/books/books-17.jpg',
         title: 'Методы менеджмента качества',
         date: '№10 октябрь 2024'
      },
      { 
         src: 'images/books/books-16.jpg',
         title: 'Business Excellence',
         date: '№10 декабрь 2024'
      },
      { 
         src: 'images/books/books-14.jpg',
         title: 'Контроль качества продукции',
         date: '№ 8 август 2024'
      },
      { 
         src: 'images/books/books-15.jpg',
         title: 'Мир измерений',
         date: '№2 май 2024'
      }
   ]

section.section.section--books
   .section__wrapper.container
      .section__content
         .books.books--2
            .books__inner
               .books__section
                  .books__header
                     h2.books__title Журналы
                     a.button.button--icon(href="#")
                        span Все журналы
                        i.icon.icon-arrow-right
                  .books__content
                     ul.books__list
                        each book in books09
                           li.books__item
                              a.books__card(href="#")
                                 .books__box
                                    button.books__like
                                    .books__img
                                       img(src=book.src, alt=book.title width="380" height="380")
                                 .books__info
                                    p.books__date= book.date
                                    h3.books__name= book.title