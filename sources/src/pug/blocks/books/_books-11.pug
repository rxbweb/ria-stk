section.section.section--books
   .section__wrapper.container
      .section__header.section__header--margin.section__header--border
         .section__header-row
            h2.section__header-title Рекомендации
      .section__content
         .books.books--2
            .books__inner
               .books__section
                  .books__content
                     .books__swiper
                        .books__swiper-slider
                           .swiper-wrapper
                              each book in books11
                                 .swiper-slide
                                    .books__item
                                       .books__box
                                          +favorite-button()
                                          .books__img
                                             +picture(book.img, false, book.title, 380, 380)
                                       .books__info
                                          h3.books__name= book.title
                                          p.books__date= book.date
                           +swiperControls()