section.section
   .section__wrapper.container
      .section__header
         .section__header-row
            h1.section__header-title Архив
      .section__content
         .books
            .books__inner
               .books__section
                  .books__content
                     ul.books__list
                        each book in books02
                           li.books__item
                              .books__box
                                 button.books__like
                                 .books__img
                                    img(src=book.img, alt="книга" width="380" height="380")
                              .books__info
                                 p.books__text= book.date
                                 h3.books__name= book.title
                                 .books__bottom
                                    p.books__price= book.price
                                    .books__manage
                                       a.button.button--icon(href="#")
                                          span В корзину
                                          i.icon.icon-cart
                                       a.button.button--outline(href="#")
                                          span Купить в 1 клик
                                          i.icon.icon-arrow-small
                     .books__pagination
                        include ../_pagination