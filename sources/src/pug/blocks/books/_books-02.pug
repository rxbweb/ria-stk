section.section.section--books.section--sidebar
   .section__wrapper.container
      .section__header
         .section__header-row
            h1.section__header-title Архив
            +select(false, ['Год: 2023', 'Год: 2024', 'Год: 2025'], 'select--wide', 'icon-date', 'Выбрать год', type = 'link')
         include ../sidebar/_sidebar
      .section__content
         .books
            .books__inner
               .books__section
                  .books__content
                     +booksList(books02)
                     .books__pagination
                        include ../pagination/_pagination