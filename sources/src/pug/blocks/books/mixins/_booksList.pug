include ../../../mixins/_mixins

mixin booksList(list, sliceNum = list.length)
   ul.books__list
      each book in list.slice(0, sliceNum)
         li.books__item
            .books__card
               .books__box
                  button.favorite-button
                  .books__img
                     if book.img
                        +picture(book.img, false, book.title, 380, 380)
               .books__info
                  if book.date
                     p.books__text= book.date
                  if book.title
                     h3.books__name= book.title
                  if book.price || book.buttons
                     .books__bottom
                        if book.price
                           p.books__price= book.price
                        if book.buttons
                           .books__manage
                              if book.buttons.read
                                 +button('Читать статью', 'button--outline', 'icon-arrow-right')
                              if book.buttons.buy
                                 a.button.button--slim.button--icon(href="#")
                                    span.button__text-desktop Купить книгу
                                    span.button__text-mob В корзину
                                    i.icon.icon-cart
                              if book.buttons.basket
                                 +button('В корзину', 'button--icon', 'icon-cart')
                              if book.buttons.click
                                 +button('Купить в 1 клик', 'button--outline', 'icon-arrow-right')