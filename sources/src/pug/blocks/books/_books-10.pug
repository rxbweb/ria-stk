include ../../mixins/_mixins

-
   const books10 = [
      {
         img: 'images/books/books-22.jpg',
         title: 'Бизнес-план — стань хозяином своего дела',
      },
      {
         img: 'images/books/books-23.jpg',
         title: 'Финансовый ликбез',
      },
      {
         img: 'images/books/books-24.jpg',
         title: 'Процессный подход / проектное управление',
      },
      {
         img: 'images/books/books-25.jpg',
         title: 'Модель EFQM - путь к совершенству',
      },
   ]

section.section
   .section__wrapper.container
      .section__content
         .books
            .books__inner
               .books__section
                  .books__header
                     h2.books__title Тематические подборки
                     +button('Все подборки', 'button--icon', 'icon-arrow-right')
                  .books__content
                     ul.books__list
                        each book in books10
                           li.books__item
                              .books__card
                                 .books__box
                                    button.favorite-button
                                    .books__img
                                       +picture(book.img, false, book.title, 380, 380)
                                 .books__info
                                    h3.books__name= book.title
                                    .books__bottom
                                       .books__manage
                                          +button('Купить книгу', 'button--icon button--slim', 'icon-cart')
                                          +button('Купить в 1 клик', 'button--outline', 'icon-arrow-right')