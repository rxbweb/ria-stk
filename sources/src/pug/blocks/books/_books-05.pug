section.section
   .section__wrapper.container
      .section__content
         .books
            .books__inner
               .books__section
                  .books__header
                     h2.books__title Реклама на других ресурсах
                  .books__content
                     .books__swiper
                        .books__swiper-slider
                           .swiper-wrapper
                              each book in books05
                                 .swiper-slide
                                    .books__item
                                       .books__box
                                          button.books__like
                                          .books__img
                                             img(src=book.img, alt=book.title width="380" height="380")
                                       .books__info
                                          h3.books__name= book.title
                        .swiper-controls
                           button.js-books-prev.swiper-button-prev
                           .swiper-pagination.js-books-pagination
                           button.js-books-next.swiper-button-next