section.section
   .section__wrapper.container
      .section__content
         .books
            .books__inner
               .books__section
                  .books__header
                     h2.books__title Книги
                  .books__content
                     ul.books__list
                        each book in books12.slice(0, 4)
                           li.books__item
                              .books__card
                                 .books__box
                                    button.favorite-button
                                    .books__img
                                       +picture(book.img, false, book.title, 380, 380)
                                 .books__info
                                    h3.books__name= book.title
                                    .books__bottom
                                       p.books__price= book.price
                                       .books__manage
                                          a.button.button--slim.button--icon(href="#")
                                             span.button__text-desktop Купить книгу
                                             span.button__text-mob В корзину
                                             i.icon.icon-cart
                                          +button('Купить в 1 клик', 'button--outline', 'icon-arrow-right')