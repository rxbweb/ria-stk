section.section.section--news
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Статьи
            a.section__header-button.button.button--icon(href="#")
               span Посмотреть все статьи
               i.icon.icon-arrow-small
      .section__content
         .news
            .news__inner
               .news__row
                  ul.news__posts
                     li.news__posts-item
                        .news__posts-img
                           img(src="images/news/news-articles-01.jpg", alt="картинка статьи" width="519" height="390")
                        .news__posts-info
                           h3.news__posts-title.title.title--second Надежная доказательная база для оценки инвестпроектов
                           a.news__posts-button.button.button--outline(href="#")
                              span Читать статью
                              i.icon.icon-arrow-small
                     li.news__posts-item
                        .news__posts-img
                           img(src="images/news/news-articles-02.jpg", alt="картинка статьи" width="519" height="390")
                        .news__posts-info
                           h3.news__posts-title.title.title--second О нормативном регулировании в области использования атомной энергии
                           a.news__posts-button.button.button--outline(href="#")
                              span Читать статью
                              i.icon.icon-arrow-small

                  aside.news__aside
                     .news__articles
                        ul.news__articles-list
                           li.news__articles-item
                              h3.news__articles-title.title.title--second Обязательную маркировку медицинских перчаток введут в России с 2025 года
                              a.news__articles-button.button.button--outline(href="#")
                                 span Читать новость
                                 i.icon.icon-arrow-small
                           li.news__articles-item
                              h3.news__articles-title.title.title--second В России предложили выдавать предостережения бизнесу через систему маркировки
                              a.news__articles-button.button.button--outline(href="#")
                                 span Читать новость
                                 i.icon.icon-arrow-small
                           li.news__articles-item
                              h3.news__articles-title.title.title--second РИА «Стандарты и качество» отмечено благодарственным письмом от руководителя Росстандарта
                              a.news__articles-button.button.button--outline(href="#")
                                 span Читать новость
                                 i.icon.icon-arrow-small
      .section__footer
         a.section__footer-button.button.button--icon(href="#")
            span Посмотреть все статьи
            i.icon.icon-arrow-small