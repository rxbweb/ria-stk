include ../../mixins/_mixins

-
   const news02 = [
      {
         src: 'images/news/news-articles-01.jpg',
         title: 'Надежная доказательная база для оценки инвестпроектов'
      },
      {
         src: 'images/news/news-articles-02.jpg',
         title: 'О нормативном регулировании в области использования атомной энергии'
      }
   ]

section.section.section--news
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Статьи
            +button-icon('link', 'Посмотреть все статьи', 'section__header-button')
      .section__content
         .news
            .news__inner
               .news__row
                  ul.news__posts
                     each news in news02
                        li.news__posts-item
                           a.news__posts-box(href="#")
                              .news__posts-img
                                 img(src=news.src, alt="картинка статьи" width="519" height="390")
                              .news__posts-info
                                 h3.news__posts-title #{news.title}
                                 +button-outline('link', 'Читать статью', 'news__posts-button')
                  aside.news__aside
                     .news__articles
                        ul.news__articles-list
                           each article in ['Обязательную маркировку медицинских перчаток введут в России с 2025 года', 'В России предложили выдавать предостережения бизнесу через систему маркировки', 'РИА «Стандарты и качество» отмечено благодарственным письмом от руководителя Росстандарта']
                              li.news__articles-item
                                 h3.news__articles-title #{article}
                                 +button-outline('link', 'Читать новость', 'news__articles-button')
      .section__footer
         +button-icon('link', 'Посмотреть все статьи', 'section__footer-button')