include ../../mixins/_mixins

-
   const news01 = [
      {
         img: 'images/news/news-01.jpg',
         mark: 'Международное сотрудничество',
         title: 'РИА «Стандарты и качество» отмечено благодарственным письмом от руководителя Росстандарта'
      },
      {
         img: 'images/news/news-02.jpg',
         mark: 'Международное сотрудничество',
         title: 'В России появятся цифровые паспорта промышленной продукции'
      },
      {
         img: 'images/news/news-03.jpg',
         mark: 'Международное сотрудничество',
         title: 'Опубликован новый рейтинг эффективности технических комитетов'
      }
   ]

section.section.section--news
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Новости
            +button-icon('link', 'Посмотреть все новости', 'section__header-button')
         .section__header-bottom
            .tags
               a.tags__button(href="#") Название тегов длинного тега
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов длинного тега
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов длинного тега
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов длинного тега
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов длинного тега
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов длинного тега
      .section__content
         .news
            .news__inner
               .news__row
                  ul.news__list
                     each news in news01
                        li.news__item
                           .news__left
                              .news__img
                                 +picture(news.img, false, "Новости", 380, 180)
                           .news__right
                              .news__info
                                 .news__top
                                    p.news__mark #{news.mark}
                                 h3.news__title #{news.title}
                                 +button-outline('link', 'Читать новость', 'news__button')
                  aside.news__aside
                     .news__articles
                        ul.news__articles-list
                           each article in ['Обязательную маркировку медицинских перчаток введут в России с 2025 года', 'В России предложили выдавать предостережения бизнесу через систему маркировки', 'РИА «Стандарты и качество» отмечено благодарственным письмом от руководителя Росстандарта']
                              li.news__articles-item
                                 h3.news__articles-title= article
                                 +button-outline('link', 'Читать новость', 'news__articles-button')
      .section__footer
         +button-icon('link', 'Посмотреть все новости', 'section__footer-button')