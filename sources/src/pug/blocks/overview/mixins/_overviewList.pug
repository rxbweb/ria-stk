include ../../../mixins/_mixins

mixin overviewList(list)   
   ul.overview__list
      each overview in list
         li.overview__item
            .overview__top
               if overview.tag
                  .tags
                     .tags__button= overview.tag
               .overview__label
                  +svg('icon-lock-03', '', 22, 26)
            if overview.name
               h3.overview__name= overview.name
            if overview.authors
               .overview__box
                  p Авторы
                  .overview__names= overview.authors
            if overview.text
               .overview__text
                  p= overview.text
            .overview__bottom
               +button-icon('link', 'Читать статью')