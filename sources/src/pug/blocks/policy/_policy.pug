include ../../mixins/_mixins

section.section.section--policy
   .section__wrapper.container
      .section__content
         .policy
            .policy__inner
               .policy__row
                  .policy__visual
                     .policy__img
                        +picture("images/policy/policy-01.jpg", false, "картинка", 800, 450)
                  .policy__info
                     h2.policy__title Редакционная политика
                     .policy__text
                        p Издатель, редакционная коллегия и редакция журнала придерживаются политики открытого доступа, предполагающей размещение опубликованных текстов статей на сайте журнала, а также в электронных библиотеках и наукометрических базах, с которыми сотрудничает журнал.
                     +button-icon('link', 'Подробнее')
