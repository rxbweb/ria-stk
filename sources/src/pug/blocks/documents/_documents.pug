-
   const documents = [
      {
         title: 'Редакционная политика',
         label: 'Скачать редакционную политику, размер 1.0 MB',
      },
      {
         title: 'Публичная офферта',
         label: 'Скачать публичную оферту, размер 1.0 MB',
      },
   ]

section.section.section--documents
   .section__wrapper
      .section__header
         .section__header-row
            h2.section__header-title Документы
      .section__content
         .documents
            .documents__inner
               ul.documents__list
                  each document in documents
                     li
                        a.documents__download(href="#" download aria-label=document.label)
                           .documents__icon
                              svg(width="26" height="26")
                                 use(href='images/sprites/main.stack.svg#svg-icon-doc')
                           .documents__info
                              p.documents__title= document.title
                              p.documents__size 1.0 MB