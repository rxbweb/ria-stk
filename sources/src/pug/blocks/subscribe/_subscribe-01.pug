include ../../mixins/_mixins

section.section.section--subscribe
   .section__wrapper.container
      .section__header.section__header--border
         .section__header-row
            h2.section__header-title Подписка
      .section__content
         .subscribe
            .subscribe__main
               .subscribe__content
                  .subscribe__img
                     +picture('images/subscribe/subscribe-img.jpg', false, 'журналы', 522, 522)
               .subscribe__info
                  .subscribe__header
                     h3.subscribe__title Подписка
                     +button-icon('link', 'Получи скидку XXX%', 'button--white button--reverse subscribe__stock', 'icon-percent')
                  .subscribe__table
                     .subscribe__table-col
                        .subscribe__table-title Версия
                        .subscribe__table-title 2025
                        .subscribe__table-title 1 полугодие
                     .subscribe__table-col
                        .subscribe__table-item
                           p.subscribe__table-type Печатная
                        label.subscribe__table-item
                           input(type="radio" name="subscribe" value="99 999 руб." checked)
                           span.subscribe__table-button 99 999 руб.
                        label.subscribe__table-item
                           input(type="radio" name="subscribe" value="99 999 руб.")
                           span.subscribe__table-button 99 999 руб.
                     .subscribe__table-col
                        .subscribe__table-item
                           p.subscribe__table-type Печатная + Электронная
                        label.subscribe__table-item
                           input(type="radio" name="subscribe" value="99 999 руб.")
                           span.subscribe__table-button 99 999 руб.
                        label.subscribe__table-item
                           input(type="radio" name="subscribe" value="99 999 руб.")
                           span.subscribe__table-button 99 999 руб.
                     .subscribe__table-col
                        .subscribe__table-item
                           p.subscribe__table-type Электронная
                        label.subscribe__table-item
                           input(type="radio" name="subscribe" value="99 999 руб.")
                           span.subscribe__table-button 99 999 руб.
                        label.subscribe__table-item
                           input(type="radio" name="subscribe" value="99 999 руб.")
                           span.subscribe__table-button 99 999 руб.
                  .subscribe__manage
                     .subscribe__manage-col.subscribe__manage-col--desktop
                        +button-icon('link', 'Получи скидку XXX%', 'button--white button--reverse subscribe__stock', 'icon-percent')
                     .subscribe__manage-col
                        +button-icon('link', 'Подписаться', 'subscribe__btn')
                        +button-icon('link', 'Добавить в корзину', 'button--white', 'icon-cart')
                        +button-outline('link', 'Купить в 1 клик')