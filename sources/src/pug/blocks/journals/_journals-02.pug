-
   const journals02 = [
      { 
         src: 'images/journals/journals-01.png', 
         title: 'стандарты и качество' 
      },
      { 
         src: 'images/journals/journals-06.png', 
         title: 'Методы менеджмента качества' 
      },
      { 
         src: 'images/journals/journals-05.png', 
         title: 'Business Excellence' 
      }
   ]

section.section
   .section__wrapper.container
      .section__header.visually-hidden
         .section__header-row
            h2.section__header-title Журналы
            include ../button/_button.pug
            +button('Подписаться на журналы', 'button--icon section__header-button', 'icon-arrow-small')
      .section__content
         .journals
            .journals__inner
               ul.journals__list
                  each journal in journals02
                     li.journals__item
                        .journals__top
                           .journals__img
                              img(src=journal.src, width="240", height="340")
                        .journals__info
                           h3.journals__name= journal.title
                           a.journals__link(href="#") 
                              span Подробнее
                              i.icon.icon-arrow-small