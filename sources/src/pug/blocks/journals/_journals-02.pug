include ../../mixins/_mixins

-
   const journals02 = [
      { 
         img: 'images/journals/journals-01.png', 
         title: 'стандарты и качество' 
      },
      { 
         img: 'images/journals/journals-06.png', 
         title: 'Методы менеджмента качества' 
      },
      { 
         img: 'images/journals/journals-05.png', 
         title: 'Business Excellence' 
      }
   ]

section.section
   .section__wrapper.container
      .section__header.visually-hidden
         .section__header-row
            h2.section__header-title Журналы
            +button-icon('link', 'Подписаться на журналы', 'section__header-button')
      .section__content
         .journals
            .journals__inner
               ul.journals__list
                  each journal in journals02
                     li.journals__item
                        .journals__top
                           .journals__img
                              +picture(journal.img, false, journal.title, 240, 340)
                        .journals__info
                           h3.journals__name= journal.title
                           +button-outline('link', 'Подробнее')