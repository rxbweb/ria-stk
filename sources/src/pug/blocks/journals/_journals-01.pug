include ../../mixins/_mixins

-
   const journals01 = [
      { 
         src: 'images/journals/journals-01.png', 
         title: 'стандарты и качество' 
      },
      { 
         src: 'images/journals/journals-02.png', 
         title: 'Менеджмент качества' 
      },
      { 
         src: 'images/journals/journals-03.png', 
         title: 'Контроль качества продукции' 
      },
      { 
         src: 'images/journals/journals-04.png', 
         title: 'Мир измерений' 
      },
      { 
         src: 'images/journals/journals-05.png', 
         title: 'Business Excellence' 
      },
      { 
         src: 'images/journals/journals-06.png', 
         title: 'Методы менеджмента качества' 
      },
   ]

section.section
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-heading Журналы
            +button('Подписаться на журналы', 'button--icon section__header-button', 'icon-arrow-small')
      .section__content
         .journals
            .journals__inner
               ul.journals__list
                  each journal in journals01
                     li.journals__item
                        .journals__top
                           .journals__img
                              img(src=journal.src, alt=journal.title, width="240", height="340")
                        .journals__info
                           h3.journals__name #{journal.title}
                           +button('Подробнее', 'button--outline', 'icon-arrow-small')