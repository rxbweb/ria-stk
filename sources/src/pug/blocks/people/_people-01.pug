section.section.section--people
   .section__wrapper.container
      .section__content
         .people
            .people__inner
               .people__row
                  .people__aside
                     h2.people__title Руководство компании
                  .people__content
                     ul.people__list.people__list--3
                        each person in people01
                           li.people__item
                              .people__photo
                                 img(src=person.src, alt=person.name, width="380", height="460")
                              .people__info
                                 p.people__name #{person.name}
                                 p.people__text #{person.text}
                                 a.people__link.button.button--outline(href="#")
                                    | Подробнее
                                    i.icon.icon-arrow-small