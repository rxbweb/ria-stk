include ../../../mixins/_mixins

mixin peopleList(people, extraClass)
   ul.people__list(class=extraClass)
      each person in people
         li.people__item
            .people__photo
               if person.img
                  +picture(person.img, false, person.name, 380, 460)
            if person.name || person.text
               .people__info
                  if person.name
                     p.people__name #{person.name}
                  if person.text
                     p.people__text #{person.text}
                  +button-outline('link', 'Подробнее', 'people__link')