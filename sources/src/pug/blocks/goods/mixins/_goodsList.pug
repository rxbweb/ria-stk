mixin goodsList(items)
   ul.goods__table-list
      each item in items
         li.goods__table-item
            .goods__table-col
               p.goods__table-heading Наименование
               if item.imgLarge
                  .goods__table-img.goods__table-img--large
                     if item.src
                        img(src=item.src, alt=item.name width="80" height="80")
               else if item.imgDisk
                  .goods__table-img
                     if item.src
                        img(src=item.src, alt=item.name width="80" height="80")
               else
                  if item.src
                     .goods__table-img
                        img(src=item.src, alt=item.name width="50" height="68")
                  else
                     .goods__table-img.goods__table-img--empty
                        img(src='images/icons/people.svg', alt=item.name width="48" height="48")
               p.goods__table-name!= item.name
            .goods__table-col
               p.goods__table-heading Цена
               if item.priceOld || item.priceNew || item.discount
               .goods__table-price
                  if item.priceOld
                     p.goods__table-price-old #{item.priceOld} руб.
                  if item.priceNew
                     p.goods__table-price-new #{item.priceNew} руб.
                  if item.discount
                     p.goods__table-price-discount #{item.discount}
            .goods__table-col
               p.goods__table-heading Количество
               if item.quantity
                  p.goods__table-count #{item.quantity}
               else if item.controls
                  .goods__table-controls
                     button.goods__table-controls-button -
                     .goods__table-controls-count #{item.controls}
                     button.goods__table-controls-button +
               else
                  p.goods__table-count -
            .goods__table-col
               p.goods__table-heading Сумма
               if item.total
                  p #{item.total} руб.
               else
                  p -
            .goods__table-col
               button.goods__table-delete