include ../../../mixins/_mixins

mixin goodsList(items)
   ul.goods__table-list
      each item in items
         li.goods__table-item
            .goods__table-col
               p.goods__table-heading Наименование
               if item.imgLarge
                  .goods__table-img.goods__table-img--large
                     if item.img
                        +picture(item.img, false, item.name, 80, 80)
               else if item.imgDisk
                  .goods__table-img
                     if item.img
                        +picture(item.img, false, item.name, 80, 80)
               else
                  if item.img
                     .goods__table-img
                        img(src=item.img, alt=item.name width="50" height="68")
                  else
                     .goods__table-img
                        svg(width="52" height="52")
                           use(href="images/sprites/main.stack.svg#svg-icon-users")
               p.goods__table-name!= item.name
            .goods__table-col
               p.goods__table-heading Цена
               if item.priceOld || item.priceNew || item.discount
               .goods__table-price
                  if item.priceOld
                     p.goods__table-price-old #{item.priceOld} руб.
                  if item.priceNew
                     p.goods__table-price-new #{item.priceNew} руб.
                  if item.discount
                     p.goods__table-price-discount #{item.discount}
            .goods__table-col
               p.goods__table-heading Количество
               if item.quantity
                  p.goods__table-count #{item.quantity}
               else if item.controls
                  .goods__table-controls
                     button.goods__table-controls-button(aria-label="уменьшить количество этого продукта") -
                     .goods__table-controls-count(aria-label="количество этого продукта") #{item.controls}
                     button.goods__table-controls-button(aria-label="увеличить количество этого продукта") +
               else
                  p.goods__table-count -
            .goods__table-col
               p.goods__table-heading Сумма
               if item.total
                  p #{item.total} руб.
               else
                  p -
            .goods__table-col
               button.goods__table-delete
                  svg(width="26" height="26")
                     use(href="images/sprites/main.stack.svg#svg-delete")