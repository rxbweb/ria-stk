include ../../../mixins/_mixins

mixin projectsSwiper(title, list, bottom)
   section.section.section--projects
      .section__bg
         img(src="images/projects/projects-bg.jpg", alt="фоновая картинка" width="1920" height="858")
      .section__wrapper.container
         .section__header
            .section__header-column
               h2.section__header-title= title
         .section__content
            .projects
               .projects__inner
                  .projects__swiper.swiper.js-projects-swiper
                     .swiper-wrapper
                        each project in list
                           .projects__item.swiper-slide
                              .projects__img
                                 img(src=project.src, alt=project.title)
                                 .projects__panel
                                    a.button.button--icon(href="#")
                                       span Узнать больше
                                       i.icon.icon-arrow-right
                              .projects__info
                                 h3.projects__title #{project.title}
                     .swiper-controls
                        button.js-projects-prev.swiper-button-prev
                        .swiper-pagination.js-projects-pagination
                        button.js-projects-next.swiper-button-next
                  if bottom === true
                     .projects__bottom
                        +button('Посмотреть все спецпроекты')