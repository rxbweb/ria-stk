include ../../../mixins/_mixins

mixin projectsSwiper(title, list, bottom)
   section.section.section--projects
      .section__bg
         img(src="images/projects/projects-bg.jpg", alt="фоновая картинка" width="1920" height="858")
      .section__wrapper.container
         .section__header
            .section__header-column
               h2.section__header-title= title
         .section__content
            .projects
               .projects__inner
                  .projects__swiper.swiper
                     .swiper-wrapper
                        each project in list
                           .projects__item.swiper-slide
                              .projects__img
                                 +picture(project.img, false, project.title, 518, 349)
                                 .projects__panel
                                    +button-icon('link', 'Узнать больше')
                              .projects__info
                                 h3.projects__title #{project.title}
                     +swiperControls()
                  if bottom === true
                     .projects__bottom
                        +button('Посмотреть все спецпроекты')