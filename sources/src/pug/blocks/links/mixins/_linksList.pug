include ../../../mixins/_mixins

mixin linksList(items, className)
   ul(class=["links__list"] + (className ? " " + [className] : []))
      each link in items
         li
            a.links__button(href="#")
               .links__info
                  p.links__name!=link.name
                  if link.text
                     p.links__text!=link.text
               .links__icon
                  +svg('icon-arrow-right-large', '', 24, 24)