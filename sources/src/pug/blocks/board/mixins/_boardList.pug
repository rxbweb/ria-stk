include ../../../mixins/_mixins

mixin boardList(boards)   
   ul.board__list
      each board in boards
         li.board__item
            a.board__box(href="#")
               .board__img
                  if board.photo
                     +picture(board.photo, false, board.name, 180, 200)
                  else
                     svg(width="60" height="60")
                        use(href='images/sprites/main.stack.svg#svg-icon-camera')
               if board.name || board.text
               .board__info
                  if board.name
                     p.board__name=board.name
                  if board.text
                     p.board__text=board.text
                  +button-outline('link', 'Подробнее')