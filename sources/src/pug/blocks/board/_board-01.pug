section.section.section--board
   .section__wrapper.container
      .section__header.section__header--margin
         .section__header-row
            h1.section__header-heading Редакционный совет
      .section__content
         .board
            .board__inner
               ul.board__list
                  each board in board01
                     li.board__item
                        a.board__box(href="#")
                           .board__img
                              if board.photo
                                 img(src=board.photo, alt=board.name width="180" height="200")
                           .board__info
                              p.board__name=board.name
                              p.board__text=board.text
                              .button.button--outline
                                 span Подробнее
                                 i.icon.icon-arrow-right