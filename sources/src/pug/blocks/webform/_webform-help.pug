include ../../mixins/_mixins

.webform
   form.webform__form(action="#" data-validate-form)
      .webform__body
         .webform__header
            h3.webform__name Нужна помощь? Сообщите нам
         p Заполните эту форму, если вы не получили обратную связь по рукописи или у вас появился какой-нибудь вопрос.
         .webform__inputs
            label.webform__label
               span.webform__label-row
                  span.webform__label-title Тема обращения
                  span.webform__label-error Обязательное поле
               span.webform__label-field
                  input.webform__label-input(type="text" placeholder="Тема обращения" name="webform-theme" required)
            label.webform__label
               span.webform__label-row
                  span.webform__label-title Текст обращения
               span.webform__label-field
                  textarea.webform__label-textarea(placeholder="Коротко объясните суть проблемы (необязательно)")
         +button('Отправить', 'webform__button', '', false)