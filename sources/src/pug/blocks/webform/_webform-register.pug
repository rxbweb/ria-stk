include ../../mixins/_mixins

.webform
   h2.webform__title Регистрация
   form.webform__form.webform__form--narrow(action="#" data-validate-form)
      .webform__body
         .webform__top
            .webform__accounts
               a.webform__accounts-btn(href="#" aria-label="vkontakte")
                  img(src="images/icons/vk.svg", alt="vk" width="39" height="23")
               a.webform__accounts-btn(href="#" aria-label="yandex")
                  img(src="images/icons/yandex.svg", alt="yandex" width="40" height="40")
               a.webform__accounts-btn(href="#" aria-label="gmail")
                  img(src="images/icons/gmail.svg", alt="gmail" width="34" height="36")
            p.webform__remark
               span или через email
         .webform__inputs
            label.webform__label
               span.webform__label-row
                  span.webform__label-title Логин
                  span.webform__label-error Обязательное поле
               span.webform__label-field
                  input.webform__label-input(type="text" placeholder="Логин" name="login" minlength="3" required)
               span.webform__label-row
                  span.webform__label-note Минимум 3 символа
            label.webform__label
               span.webform__label-row
                  span.webform__label-title Email
                  span.webform__label-error Обязательное поле
               span.webform__label-field
                  input.webform__label-input(type="email" placeholder="Электронная почта" name="email" required)
            label.webform__label
               span.webform__label-row
                  span.webform__label-title Пароль
                  span.webform__label-error Обязательное поле
               span.webform__label-field.webform__label-field--icon
                  input.webform__label-input(type="password" placeholder="Пароль" name="password" minlength="6" required)
                  span.webform__label-icon.webform__label-icon--eye.button-eye
                     +svg('icon-eye', 'svg-icon-eye', 22, 16)
                     +svg('icon-eye-not', 'svg-icon-eye-not', 24, 18)
               span.webform__label-row
                  span.webform__label-note Минимум 6 символов
            label.webform__label
               span.webform__label-row
                  span.webform__label-title Подтверждение пароля
                  span.webform__label-error Обязательное поле
               span.webform__label-field.webform__label-field--icon
                  input.webform__label-input(type="password" placeholder="Пароль" name="password" required)
                  span.webform__label-icon.webform__label-icon--eye.button-eye
                     +svg('icon-eye', 'svg-icon-eye', 22, 16)
                     +svg('icon-eye-not', 'svg-icon-eye-not', 24, 18)
         .agree.agree--secondary
            label.agree__label
               input(type="checkbox" name="form-agree" required)
               span.agree__checkbox
               span.agree__text Даю согласие на отправку мне издательством РИА СТК электронных рассылок
            .agree__error Обязательное поле
         +button('Зарегистрироваться', 'button--large', '', false)
         p.webform__description Нажимая кнопку, вы принимаете условия #[a(href="#") политики] и #[a(href="#") пользовательского соглашения]
      .webform__bottom
         .webform__manage
            span Уже есть аккаунт?
            +button-outline('link', 'Войти')