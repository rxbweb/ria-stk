mixin webformAccessItem(users)
   each user in users
      li.webform__access-item
         .webform__access-col
            p.webform__access-title ФИО
            p.webform__access-info(class=(user.isBlocked ? 'is-blocked' : ''))= user.name
         .webform__access-col
            p.webform__access-title Email
            p.webform__access-info= user.email
         .webform__access-col
            p.webform__access-title Пароль
            p.webform__access-info ********
         if user.isBlocked
            +webformControls('secondary')
         else
            +webformControls()

