mixin webformFile()   
   label.webform__label
      span.webform__label-row
         span.webform__label-title Карточка предприятия
         div.webform__label-question
            +svg('icon-question', '', 20, 20)
            p.webform__label-question-text Текст подсказки
      span.webform__label-input.webform__label-file
         input(type="file")
         span.webform__label-file-choose Выбрать файл
         span.webform__label-file-name Файл не выбран