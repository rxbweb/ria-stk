include ../../mixins/_mixins
include ../download/mixins/_downloadList

.webform
   form.webform__form(action="#" data-validate-form)
      .webform__body
         .webform__header
            h3.webform__name Загрузить новую рукопись
         .webform__inputs
            label.webform__label
               span.webform__label-row
                  span.webform__label-title Название рукописи
                  span.webform__label-error Обязательное поле
               span.webform__label-field
                  input.webform__label-input(type="text" placeholder="Введите название рукописи" name="webform-manuscript" required)
         +downloadList('Ваша рукопись', 'Публичная оферта')
         .webform__controls
            .agree
               label.agree__label
                  input(type="checkbox" name="webform-agree" required)
                  span.agree__checkbox
                  span.agree__text Ознакомлен с #[a(href="#") редакционной политикой]
               span.agree__error Обязательное поле
         +button('Отправить', 'webform__button', '', false)