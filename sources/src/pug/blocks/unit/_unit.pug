   const unitList = [
      {
         name: 'Печатная',
         description: '(комплект с business Excellence)',
         labelFirst: {
            priceCurrent: '47 640 ₽',
            priceOld: '47 640 ₽',
         },
         labelSecond: {
            priceCurrent: '71 400 ₽',
            priceOld: '47 640 ₽',
         },
      },
      {
         name: 'Электронная',
         description: '(комплект с business Excellence)',
         labelFirst: {
            priceCurrent: '47 640 ₽',
            priceOld: '47 640 ₽',
         },
         labelSecond: {
            priceCurrent: '71 400 ₽',
            priceOld: '47 640 ₽',
         },
      },
      {
         name: 'Электронная',
         labelFirst: {
            priceCurrent: '47 640 ₽',
            priceOld: '47 640 ₽',
         },
         labelSecond: {
            priceCurrent: '71 400 ₽',
            priceOld: '47 640 ₽',
         },
      },
      {
         name: 'Печатная + электронная',
         description: '(комплект с business Excellence)',
         labelFirst: {
            priceCurrent: '47 640 ₽',
