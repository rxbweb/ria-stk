include ../../mixins/_mixins

-
   const choiceList = [
      {
         name: 'Печатная',
         text: 'Подписка на бумажную версию позволит всегда иметь журнал под рукой вне зависимости от наличия гаджетов и интернета.',
      },
      {
         name: 'Электронная',
         text: 'Подписка на бумажную версию позволит всегда иметь журнал под рукой вне зависимости от наличия гаджетов и интернета.',
      },
      {
         name: 'Мобильная',
         text: 'Подписка на бумажную версию позволит всегда иметь журнал под рукой вне зависимости от наличия гаджетов и интернета.',
      },
   ]

section.section.section--choice
   .section__wrapper.container
      .section__header.section__header--border
         .section__header-row
            h2.section__header-title Подписка на ваш выбор
      .section__content
         .choice
            .choice__inner
               .choice__main
                  .choice__content
                     .choice__img
                        +picture("images/choice/choice-01.jpg", false, "Картинка", 380, 440)
                  .choice__info
                     ul.choice__list
                        each choice in choiceList
                           li.choice__item
                              p.choice__name= choice.name
                              p.choice__text= choice.text
                     .choice__bottom
                        +button-icon('link', 'Подробнее')