include ../../mixins/_mixins
include ../download/mixins/_downloadList

section.section.section--review
   .section__bg
      img(src="images/section/section-bg.jpg", alt="фоновая картинка" width="1920" height="640")
   .section__wrapper.container
      .section__content
         .review
            .review__inner
               form.review__form.form.form--2.form--large(action="#")
                  .form__header
                     h2.form__title Форма для связи
                  .form__main
                     .form__group
                        .form__box.form__box--column
                           label.form__label
                              span.form__type Имя
                              input.form__input(type="text" placeholder="Ваше имя")
                           label.form__label
                              span.form__type Фамилия
                              input.form__input(type="text" placeholder="Ваша фамилия")
                           label.form__label
                              span.form__type Отчество
                              input.form__input(type="text" placeholder="Ваше отчество")
                           label.form__label
                              span.form__type Email
                              input.form__input(type="email" placeholder="Email")
                        .form__box.form__box--column
                           label.form__label
                              span.form__type Ученое звание или статус
                              input.form__input(type="text" placeholder="Укажите ваше ученое звание или статус")
                           label.form__label
                              span.form__type Должность
                              input.form__input(type="text" placeholder="Укажите вашу должность")
                           .form__label
                              span.form__type Для размещения в журнале
                              .select.select--secondary
                                 button.select__active.is-selected
                                    span На усмотрение редакции
                                 .select__list
                                    button.select__item.is-active На усмотрение редакции
                                    button.select__item На усмотрение редакции
                                    button.select__item На усмотрение редакции
                           label.form__label
                              span.form__type Название рукописи
                              input.form__input(type="text" placeholder="Название рукописи")
                        .form__box.form__box--column
                           +downloadList('Прикрепить файл')
                           label.form__label
                              span.form__type Дополнительная информация
                              textarea.form__textarea(placeholder="Необязательно")
                           +button('Отправить', 'form__button', '', false)