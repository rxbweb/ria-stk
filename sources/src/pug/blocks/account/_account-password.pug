include ../../mixins/_mixins

section.section.section--account
   .section__wrapper.container
      .section__content
         .account
            .account__inner
               .account__form
                  .webform
                     h2.webform__title Восстановить пароль
                     form.webform__form.webform__form--narrow(action="#")
                        .webform__body
                           p.webform__description Если вы забыли пароль, введите логин или Email и следуйте инструкции  в электронном письме.
                           .webform__inputs
                              label.webform__label
                                 span.webform__label-row
                                    span.webform__label-title Логин или Email
                                    span.webform__label-error Обязательное поле
                                 span.webform__label-field
                                    input.webform__label-input(type="text" placeholder="Введите логин или email")
                                 span.webform__label-row
                                    span.webform__label-note Минимум 3 символа
                           button.webform__button.button.button--large
                                 span Отправить
                        .webform__bottom
                           .webform__manage
                              +button('Вернуться  к авторизации', 'button--outline', 'icon-arrow-right')