section.section.section--account
   .section__wrapper.container
      .section__header.section__header--margin
         .section__header-row
            h1.section__header-heading Личный кабинет
      .section__content
         .account
            .account__inner
               .account__links
                  each link in accountLinks
                     a.account__links-btn(href="#")
                        if link.value
                           .account__links-value= link.value
                        .account__links-icon
                           img(src=link.icon.src, alt="иконка" width=link.icon.width height=link.icon.height)
                        .account__links-info
                           h2.account__links-title= link.title