section.section.section--account
   .section__wrapper.container
      .section__content
         .account
            .account__inner
               .account__main
                  .account__aside
                     .account__controls
                        include ../controls/_controls
                        +controls(9)
                  .account__info
                     h2.account__title Избранное
                     .account__manage
                        .account__tabs(data-tabs="products")
                           a.account__tabs-btn.is-active(href="#" data-tab="tab1") Все
                           a.account__tabs-btn(href="#" data-tab="tab2") Статьи
                           a.account__tabs-btn(href="#" data-tab="tab3") Журналы
                           a.account__tabs-btn(href="#" data-tab="tab4") Книги
                           a.account__tabs-btn(href="#" data-tab="tab5") Архивы
                           a.account__tabs-btn(href="#" data-tab="tab6") Подборки
                        .account__search.search
                           button.search__button(aria-label="кнопка поиска")
                              svg(width="26" height="26")
                                 use(href='images/sprites/main.stack.svg#svg-icon-loop')
                           input.search__input(type="text" placeholder="Искать в избранном")
                           .search__select
                              .select
                                 button.select__active
                                    span По названию
                                 .select__list
                                    button.select__item Везде
                                    button.select__item По журналам
                                    button.select__item По книгам
                                    button.select__item По статьям
                                    button.select__item По новостям
                                    button.select__item По мероприятиям
                     .account__products(data-content="products")
                        .account__section.is-active(data-tab="tab1")
                           .account__col
                              h3.account__heading Статьи
                              .account__products-swiper.swiper-container
                                 .swiper-wrapper
                                    each book in accountFavorite01
                                       .account__products-slide.swiper-slide
                                          .books
                                             .books__item
                                                .books__card
                                                   .books__box
                                                      +favorite-button()
                                                      .books__img
                                                         +picture(book.img, false, book.title, 380, 380)
                                                   .books__info
                                                      h3.books__name= book.title
                                                      .books__bottom
                                                         .books__manage
                                                            +button-outline('link', 'Читать статью')
                                 +swiperControls()

                           .account__col
                              h3.account__heading Журналы
                              .account__products-swiper.swiper-container
                                 .swiper-wrapper
                                    each book in accountFavorite02
                                       .account__products-slide.swiper-slide
                                          .books
                                             .books__item
                                                .books__card
                                                   .books__box
                                                      +favorite-button()
                                                      .books__img
                                                         +picture(book.img, false, book.title, 380, 380)
                                                   .books__info
                                                      p.books__text= book.date
                                                      h3.books__name= book.title
                                                      .books__bottom
                                                         p.books__price= book.price
                                                         .books__manage
                                                            +button-icon('link', 'В корзину', '', 'icon-cart')
                                                            +button-outline('link', 'Купить в 1 клик')
                                 +swiperControls()

                           .account__col
                              h3.account__heading Книги
