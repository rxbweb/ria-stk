section.section.section--account
   .section__wrapper.container
      .section__content
         .account
            .account__inner
               .account__main
                  .account__aside
                     .account__controls
                        include ../controls/_controls
                        +controls(0)
                  .account__info
                     h2.account__title Избранное

                     .books
                        .books__inner
                           .books__section
                              .books__content
                                 .books__swiper
                                    .books__swiper-slider
                                       .swiper-wrapper
                                          each book in books11
                                             .swiper-slide
                                                .books__item
                                                   .books__card
                                                      .books__box
                                                         button.books__like
                                                         .books__img
                                                            img(src=book.img, alt=book.title width="380" height="380")
                                                      .books__info
                                                         h3.books__name= book.title
                                                         .books__bottom
                                                            p.books__price= book.price
                                                            .books__manage
                                                               a.button.button--slim.button--icon(href="#")
                                                                  span В корзину
                                                                  i.icon.icon-cart
                                                               a.button.button--outline(href="#")
                                                                  span Купить в 1 клик
                                                                  i.icon.icon-arrow-right
                                    .swiper-controls
                                       button.js-books-prev.swiper-button-prev
                                       .swiper-pagination.js-books-pagination
                                       button.js-books-next.swiper-button-next
