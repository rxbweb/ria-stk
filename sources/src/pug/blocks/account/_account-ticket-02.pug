include ../../mixins/_mixins

-
   const accountCard01 = [
      {
         img: 'images/card/card-03.jpg',
         text: '«Контроль качества продукции», сентябрь 2001',
         title: 'О повышении качества сертификационных испытаний',
      },
      {
         img: 'images/card/card-09.jpg',
         text: '«Контроль качества продукции», сентябрь 2001',
         title: 'Колбасные изделия: проблемы идентификации и подтверждения соответствия',
      },
   ]

section.section.section--account
   .section__wrapper.container
      .section__content
         .account
            .account__inner
               .account__main
                  .account__aside
                     .account__controls
                        include ../controls/_controls
                        +controls(0)
                  .account__info
                     h2.account__title Абонементный доступ
                     .account__text
                        p Приобретая абонемент, вы получаете полный доступ к фонду электронной библиотеки на ограниченный период времени. Абонемент будет выгоден при подготовке дипломных и научных работ, лекций и презентаций.
                     .account__card
                        h3.account__caption Мои абонементы
                        - for (let i = 0; i < 2; i++)
                           .card
                              .card__table
                                 .card__table-header
                                    .card__table-col
                                       p.card__table-detail Доступен до
                                       p.card__table-primary  
                                          time(datetime="2024-12-01") 1 декабря 2024
                                    .card__table-col
                                       p.card__table-detail Скачано статей
                                       p.card__table-primary 5 / 10
                                    .card__table-col
                                       +button('Продлить абонемент', '', '')
                                 .card__table-section
                                    h3.card__table-title Статьи
                                    .card__table-swiper
                                       .swiper-wrapper
                                          - for (let i = 0; i < 4; i++)
                                             each card in accountCard01
                                                .swiper-slide
                                                   .card__item
                                                      .card__block
                                                         .card__box
                                                            .card__icon
                                                               +svg('icon-eye', '', 28, 18)
                                                            .card__img
                                                               +picture(card.img, false, card.title, 380, 380)
                                                         .card__info
                                                            p.card__text= card.text
                                                            h3.card__name= card.title
                                                            .card__manage
                                                               +button-icon('link', 'Читать статью', 'button--slim')
                                       +swiperControls()

                  .account__panel
                     include ../spotlight/_spotlight-02