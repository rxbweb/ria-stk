section.section.section--account
   .section__wrapper.container
      .section__content
         .account
            .account__inner
               .account__main
                  .account__aside
                     .account__controls
                        include ../controls/_controls
                        +controls(9)
                  .account__info
                     h2.account__title Корзина
                     p.account__description В вашей корзине нет товаров.
                     .account__products
                        .account__col
                           h3.account__heading Рекомендуемые журналы
                           .account__products-swiper
                              .swiper-wrapper
                                 each book in accountBooks01
                                    .account__products-slide.swiper-slide
                                       .books.books--2
                                          .books__item
                                             a.books__card(href="#")
                                                .books__box
                                                   button.favorite-button
                                                   .books__img
                                                      +picture(book.img, false, book.title, 380, 380)
                                                .books__info
                                                   h3.books__name= book.title
                                                   p.books__date= book.date
                              +swiperControls()

                        .account__col
                           h3.account__heading Популярные статьи
                           .account__products-swiper
                              .swiper-wrapper
                                 each card in accountCard01
                                    .account__products-slide.swiper-slide
                                       .card
                                          .card__item
                                             .card__block
                                                .card__box
                                                   .card__icon
                                                      i.icon.icon-lock
                                                   .card__img
                                                      +picture(card.img, false, card.title, 380, 380)
                                                .card__info
                                                   p.card__text= card.text
                                                   h3.card__name= card.title
                                                   .card__manage
                                                      p.card__price= card.price
                                                      +button('В корзину', 'button--slim button--icon', 'icon-cart')
                                                      a.card__favorite.favorite-button(href="#")
                              +swiperControls()

                        .account__col
                           h3.account__heading Популярные книги
                           .account__products-swiper
                              .swiper-wrapper
                                 each book in accountBooks02
                                    .account__products-slide.swiper-slide
                                       .books
                                          .books__item
                                             .books__card
                                                .books__box
                                                   button.favorite-button
                                                   .books__img
                                                      +picture(book.img, false, book.title, 380, 380)
                                                .books__info
                                                   h3.books__name= book.title
                                                   .books__bottom
                                                      p.books__price= book.price
                                                      .books__manage
                                                         +button('Купить книгу', 'button--slim button--icon', 'icon-cart')
                                                         +button('Купить в 1 клик', 'button--outline', 'icon-arrow-right')
                              +swiperControls()

                        .account__col
                           h3.account__heading ближайшие мероприятия
                           .account__products-swiper
                              .swiper-wrapper
                                 each card in accountCard02
                                    .account__products-slide.swiper-slide
                                       .card
                                          .card__item
                                             .card__block
                                                .card__box
                                                   button.favorite-button
                                                   .card__img
                                                      +picture(card.img, false, card.title, 380, 380)
                                                .card__info
                                                   p.card__text= card.text
                                                   h3.card__name= card.title
                                                   .card__manage
                                                      +button('Подробнее', 'button--outline', 'icon-arrow-right')
                              +swiperControls()