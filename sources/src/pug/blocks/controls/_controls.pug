-
   const controls = [
      {
         title: 'Абонементный доступ',
      },
      {
         title: 'Электронные журналы',
      },
      {
         title: 'Статьи / Подборки',
      },
      {
         title: 'Книги',
      },
      {
         title: 'Мероприятия',
      },
      {
         title: 'Для авторов',
      },
      {
         title: 'Бонусная система',
      },
      {
         title: 'Избранное',
      },
      {
         title: 'Настройки профиля',
      },
      {
         title: 'Корзина',
      },
   ]

.controls
   each control, index in controls
      a.controls__btn(href="#")
         svg
            use(href=`images/sprites/main.stack.svg#svg-controls-${(index + 1).toString().padStart(2, '0')}`)
         span= control.title