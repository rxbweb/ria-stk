include ../../mixins/_mixins

mixin controls(activeIndex)
   -
      const controls = [
         { 
            title: 'Абонементный доступ',
            href: 'account-ticket-01.html'
         },
         { 
            title: 'Электронные журналы',
            href: 'account-ticket-02.html'
         },
         { 
            title: 'Статьи / Подборки',
            href: 'account-favorites.html'
         },
         { 
            title: 'Книги',
            href: 'account-favorites.html'
         },
         { 
            title: 'Мероприятия'
         },
         { 
            title: 'Для авторов',
            href: 'account-authors.html'
         },
         { 
            title: 'Бонусная система',
            href: 'account-bonus-01.html'
         },
         { 
            title: 'Избранное',
            href: 'account-favorites.html'
         },
         { 
            title: 'Настройки профиля',
            href: 'account-profile.html'
         },
         { 
            title: 'Корзина',
            href: 'account-basket-01.html'
         },
      ];

   .controls
      a.controls__toggle(href="#")
         span Навигация по личному кабинету
      .controls__main
         .controls__list
            each control, index in controls
               if activeIndex === index
                  span.controls__btn.is-active
                     svg(width="32" height="32")
                        use(href=`images/sprites/main.stack.svg#svg-controls-${(index + 1).toString().padStart(2, '0')}`)
                     span= control.title
               else
                  a.controls__btn(href= control.href)
                     svg(width="32" height="32")
                        use(href=`images/sprites/main.stack.svg#svg-controls-${(index + 1).toString().padStart(2, '0')}`)
                     span= control.title
