include ../../mixins/_mixins

mixin accordionInfoList(list)
   ul.accordion__info-list
      each item in list
         li
            a.accordion__info-button(href="#")
               span= item
               span.accordion__info-button-icon
                  +svg('icon-arrow-right', 'svg-icon-arrow-right', '14', '14')

mixin accordionMagazines()
   .accordion__box
      ul.accordion__magazines
         li.accordion__magazines-item
            .accordion__magazines-img
               +picture("images/accordion/accordion-magazine-01.jpg", false, "Cтандарты и качество", 220, 220)
            .accordion__magazines-info
               h4.accordion__magazines-title Cтандарты и качество
         li.accordion__magazines-item
            .accordion__magazines-img
               +picture("images/accordion/accordion-magazine-02.jpg", false, "Контроль и качество продукции", 220, 220)
            .accordion__magazines-info
               h4.accordion__magazines-title Контроль и качество продукции
         li.accordion__magazines-item
            .accordion__magazines-img
               +picture("images/accordion/accordion-magazine-03.jpg", false, "Business Excellence", 220, 220)
            .accordion__magazines-info
               h4.accordion__magazines-title Business Excellence

mixin accordionItem(data= 'accordion-01', title = 'Название', badge = '04', badgeWidth = '24', badgeHeight = '24')
   li.accordion__item
      a.accordion__button(href="#" data-accordion=data)
         .accordion__button-name
            .badge
               +svg(`badge-${badge}`, '', badgeWidth, badgeHeight)
            h3.accordion__button-title= title
         .accordion__button-plus
            img(src="images/icons/plus.svg", alt="раскрыть информацию" width="36" height="36")
      .accordion__wrapper
         .accordion__content
            +accordionMagazines()
            .accordion__info
               .accordion__info-col
                  a.accordion__info-tag(href="#") Полезное
                  +accordionInfoList(['Новости', 'Статьи', 'Тематические подборки'])
               .accordion__info-col
                  a.accordion__info-tag(href="#") Мероприятия
                  +accordionInfoList(['Стандартизатор года — 2024', 'Аккредитация. Компетентность', 'ИННОПРОМ'])
               .accordion__info-col
                  a.accordion__info-tag(href="#") Услуги
                  +accordionInfoList(['Реклама и продвижение', 'Спецвыпуски на заказ', 'Редакционно-издательские услуги', 'Организация мероприятий', 'Ярмарка вакансий'])

section.section.section--border.section--accordion
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Что вас интересует
      .section__content
         .accordion.accordion--secondary
            .accordion__inner
               .accordion__row
                  .accordion__picture
                     .accordion__img
                        img.accordion__pic(src="images/details/details-08.jpg", alt="картинка" width="518" height="487" data-img="accordion-01")
                        img.accordion__pic(src="images/details/details-02.jpg", alt="картинка" width="518" height="487" data-img="accordion-02")
                        img.accordion__pic(src="images/details/details-03.jpg", alt="картинка" width="518" height="487" data-img="accordion-03")
                        img.accordion__pic(src="images/news/news-articles-01.jpg", alt="картинка" width="518" height="487" data-img="accordion-04")
                  .accordion__section
                     .info__accordion
                        ul.accordion__list
                           +accordionItem('accordion-01', 'Техническое регулирование', '04', '26', '26')
                           +accordionItem('accordion-02', 'Стандартизация', '05', '26', '26')
                           +accordionItem('accordion-03', 'Управление качеством', '06', '23', '23')
                           +accordionItem('accordion-04', 'Метрология', '07', '28', '28')