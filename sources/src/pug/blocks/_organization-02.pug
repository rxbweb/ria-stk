section.section.section--padding-none.section--organization
   .section__wrapper
      .organization.organization--2
         .bg-image
            img(src="images/organization/organization-bg.jpg", alt="фоновая картинка" width="1920" height="800")
         .organization__inner.container
            .breadcrumbs.breadcrumbs--second
               .breadcrumbs__list
                  a(href="#") Главная
                  a(href="#") ВОК
            .organization__row
               .organization__left
                  .organization__logo
                     img(src="images/icons/vok.png", alt="вок" width="121" height="121")
                  h2.organization__title.title Всероссийская организация качества
                  p.organization__text Миссия Всероссийской организации качества (ВОК) — объединение усилий граждан и общественных организаций, предприятий и органов власти для содействия решению задач в области качества и конкурентоспособности отечественных продукции и услуг, формирование общероссийского движения за качество.
                  .organization__bottom
                     a.button.button--icon(href="#") 
                        span Узнать больше
                        .icon.icon-arrow-small