include ../../mixins/_mixins

.filter
   .filter__main
      ul.filter__list
         li.filter__item
            a.filter__btn(href="#")
               p.filter__name Город
            .filter__content
               .search
                  button.search__button
                     svg(width="26" height="26")
                        use(href='images/sprites/main.stack.svg#svg-icon-loop')
                  input.search__input(type="text" placeholder="Искать....")
         li.filter__item
            a.filter__btn(href="#")
               p.filter__name Тип занятости
            .filter__content
               .filter__selection
                  +agree('Полная занятость', '', 'form-agree')
                  +agree('Частичная занятость', '', 'form-agree')
                  +agree('Проектная работа', '', 'form-agree')
                  +agree('Стажировка', '', 'form-agree')
                  +agree('Волонтерство', '', 'form-agree')
         li.filter__item
            a.filter__btn(href="#")
               p.filter__name Опыт
            .filter__content
               .filter__selection
                  +agree('Нет опыта', '', 'form-agree')
                  +agree('от 1 до 3 лет', '', 'form-agree')
                  +agree('от 3 до 6 лет', '', 'form-agree')
                  +agree('более 6 лет', '', 'form-agree')