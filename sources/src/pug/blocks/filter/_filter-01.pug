include ../../mixins/_mixins

.filter
   a.filter__toggle(href="#")
      span.filter__toggle-icon
         +svg('icon-filter', '', 22, 22)
      span Фильтры
      span.filter__toggle-arrow
         +svg('icon-arrow-down', '', 16, 16)
   .filter__main
      .filter__box
         ul.filter__list
            li.filter__item
               p.filter__name Город
               .filter__block
                  .filter__content
                     .search
                        button.search__button(aria-label="кнопка поиска")
                           svg(width="26" height="26")
                              use(href='images/sprites/main.stack.svg#svg-icon-loop')
                        input.search__input(type="text" placeholder="Искать....")
            li.filter__item
               a.filter__btn(href="#")
                  p.filter__name Специализация
                  +svg('icon-arrow-down', '', 22, 22)
               .filter__block
                  .filter__content
                     .filter__selection
                        +agree('Специализация 1', '', 'form-agree')
                        +agree('Специализация 2', '', 'form-agree')
                        +agree('Специализация 3', '', 'form-agree')
                        +agree('Специализация 4', '', 'form-agree')
                        +agree('Специализация 5', '', 'form-agree')
            li.filter__item
               a.filter__btn(href="#")
                  p.filter__name Тип занятости
                  +svg('icon-arrow-down', '', 22, 22)
               .filter__block
                  .filter__content
                     .filter__selection
                        +agree('Полная занятость', '', 'form-agree')
                        +agree('Частичная занятость', '', 'form-agree')
                        +agree('Проектная работа', '', 'form-agree')
                        +agree('Стажировка', '', 'form-agree')
                        +agree('Волонтерство', '', 'form-agree')
            li.filter__item
               a.filter__btn(href="#")
                  p.filter__name Опыт
                  +svg('icon-arrow-down', '', 22, 22)
               .filter__block
                  .filter__content
                     .filter__selection
                        +agree('Нет опыта', '', 'form-agree')
                        +agree('от 1 до 3 лет', '', 'form-agree')
                        +agree('от 3 до 6 лет', '', 'form-agree')
                        +agree('более 6 лет', '', 'form-agree')
            li.filter__item
               p.filter__name Ежемесячный доход
               .filter__block
                  .filter__content
                     .range
                        .range__controls
                           input(type="text" data-range="min")
                           input(type="text" data-range="max")
                        .range__slider