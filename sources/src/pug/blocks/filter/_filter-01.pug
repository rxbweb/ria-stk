include ../../mixins/_mixins

.filter
   a.filter__toggle(href="#")
      span.filter__toggle-icon
         +svg('icon-filter', '', 22, 22)
      span Фильтры
      span.filter__toggle-arrow
         +svg('icon-arrow-down', '', 16, 16)
   .filter__main
      .filter__box
         ul.filter__list
            li.filter__item
               p.filter__name Тематика
               .filter__content
                  .filter__inputs
                     +select(false, ['Везде', 'По журналам', 'По книгам', 'По статьям', 'По новостям', 'По мероприятиям'], '', '', 'Выберите тематику')
            li.filter__item
               p.filter__name Рубрика
               .filter__content
                  .filter__inputs
                     .filter__input
                        .filter__selected
                           input(type="text")
                           button.filter__delete(aria-label="удалить выбранный элемент")
                              +svg('icon-close', '', 18, 18)
            li.filter__item
               p.filter__name Рефоративные базы и индекс
               .filter__content
                  .filter__inputs
                     .filter__input
                        input(type="text" placeholder="Искать по индексу" minlength="3" required)
                        .filter__search
                           .filter__search-item Андреев Б.В.
                           .filter__search-item Андрианов А.А.
                           .filter__search-item Андриашина Г.С.
                           .filter__search-item Андронов П.Б.
                           .filter__search-item Андрухович А.А.
                           .filter__search-item Андреев Б.В.
                           .filter__search-item Андрианов А.А.
                           .filter__search-item Андриашина Г.С.
                           .filter__search-item Андронов П.Б.
                           .filter__search-item Андрухович А.А.
            li.filter__item
               p.filter__name Авторы
               .filter__content
                  .filter__inputs
                     .filter__input
                        input(type="text" placeholder="Искать по фамилии автора" minlength="3" required)
                        .filter__search
                           .filter__search-empty Вариантов не найдено
            li.filter__item
               p.filter__name Год публикации
               .filter__content
                  .filter__year
                     label.filter__year-label
                        span.filter__year-title От
                        input(type="text" placeholder="1927" minlength="4")
                     label.filter__year-label
                        span.filter__year-title До
                        input(type="text" placeholder="2025" minlength="4")
         .filter__bottom
            +button-icon('button', 'Применить фильтры')