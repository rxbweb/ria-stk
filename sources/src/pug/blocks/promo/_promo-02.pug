include ../../mixins/_mixins

section.section.section--promo
   .section__wrapper.container
      .section__header.visually-hidden
         .section__header-row
            h2.section__header-title Рекламный баннер
      .section__content
         .promo
            .promo__inner
               ul.promo__list
                  li.promo__item
                     .promo__img
                        +picture("images/promo/promo-01.jpg", false, "картинка", 800, 468)
                     .promo__info
                        h2.promo__title Стандартизатор года
                  li.promo__item
                     .promo__img
                        +picture("images/promo/promo-02.jpg", false, "картинка", 800, 468)
                     .promo__info
                        p.promo__description 28-29 ноября 2024 года, Ярославль
                        h2.promo__title Лучший опыт - #[br] для лучшей жизни