include ../../mixins/_mixins

section.section.section--vacancy
   .section__wrapper.container
      .section__header.section__header--margin
         h1.section__header-heading Интернет-маркетолог
      .section__content
         .vacancy
            .vacancy__inner
               .vacancy__main
                  .vacancy__section
                     .vacancy__content
                        .vacancy__header
                           .vacancy__header-left
                              .vacancy__header-logo
                                 img(src="images/icons/logo.svg", alt="логотип" width="178" height="50")
                              .vacancy__header-details
                                 .vacancy__meta
                                    time.vacancy__meta-time(datetime="2024-01-01") 01.01.2024
                                    span.vacancy__meta-location Москва
                                 h3.vacancy__header-name #{'РИА «Стандарты и качество» '}
                                    |
                                    | СМИ, издательство
                           .vacancy__header-right
                              p.vacancy__price 100 000 руб.
                              +button-icon('link', 'Откликнуться')
                        .vacancy__info
                           .vacancy__info-section
                              h3.vacancy__info-title Чем предстоит заниматься:
                              .vacancy__info-text
                                 ul
                                    li администрирование сайта компании (Битрикс), повышение показателей конверсии, наполнение контентом (в компании есть контент-менеджер, но при необходимости нужно будет его подменять), контроль процесса выкладки свежих номеров журналов;
                                    li создание, размещение и продвижение контента для соцсетей: Telegram, VK, Дзен (включая посевы, TG Ads и VK реклама);
                                    li создание, оптимизация и контроль рекламных кампаний в интернете, включающих в себя полный спектр услуг (seo-продвижение, контекстная реклама, ретаргетинг, реклама в блогах, SMM/SMO, E-mail-маркетинг и др.) Поиск новых площадок и проведение тестирования на них;
                                    li разработка ТЗ для дизайнера на создание/доработку визуального контента (баннеры, иллюстрации для постов, оформление e-mail рассылок и пр.);
                                    li организация работы подрядчиков, их поиск и контроль;
                                    li ведение аналитики, контроль метрик для оценки эффективности маркетинговой стратегии, ведение отчётности;
                                    li организация партнерских размещений контента компании;
                                    li поиск новых каналов взаимодействия с целевой аудиторией.

                           .vacancy__info-section
                              h3.vacancy__info-title Требования:
                              .vacancy__info-text
                                 ul
                                    li высшее образование и опыт работы в В2В сегменте;
                                    li умение генерировать продающие предложения;
                                    li знание основ SMM, алгоритмы соц. сетей и таргетированной рекламы;
                                    li умение грамотно составлять ТЗ подрядчикам;
                                    li умение работать с различными рекламными инструментами в интернете — SEO, контекст (Яндекс.Директ), таргетинг, медийная реклама, e-mail рассылки, видео компании и др.;
                                    li иметь опыт использования инструментов веб-аналитики (Яндекс.Метрика);
                                    li знание html будет плюсом;
                                    li приветствуется наличие сертификатов Яндекс.Директ или VK;
                                    li ответственность, системность, аналитический склад ума, стремление профессионально расти в сфере маркетинга.

                           .vacancy__info-section
                              h3.vacancy__info-title Какой результат хотим получить:
                              .vacancy__info-text
                                 ul
                                    li прирост трафика на сайте компании, развитие соцсетей;
                                    li повышение узнаваемости компании и информированности о ее продуктах;
                                    li рост продаж, увеличение количества подписчиков и клиентов компании.

                           .vacancy__info-section.vacancy__info-section--white
                              h3.vacancy__info-title Условия:
                              .vacancy__info-text
                                 ul
                                    li оформление в штат по ТК РФ;
                                    li график работы с 9.00 до 18.00 или с 10.00 до 19.00;
                                    li комфортный офис в 2 минутах от метро Автозаводская.

                  .vacancy__aside.vacancy__aside--wide
                     .vacancy__spotlight
                        a.vacancy__spotlight-box(href="#")
                           img.vacancy__spotlight-bg(src="images/vacancy/vacancy-01.jpg", alt="фоновая картинка" width="520" height="50")
                           .vacancy__spotlight-info
                              h3.vacancy__spotlight-title #{'Текст для баннера '}
                                 |
                                 |в 2 строки
                              .vacancy__spotlight-icon
                                 span
                                    +svg('icon-arrow-right', 'svg-icon-arrow-right', 22, 22)