include ../../mixins/_mixins

section.section.section--intro
   .section__wrapper.container
      .section__content
         .intro.intro--third
            .bg-image
               +picture-simple("images/intro/intro-bg.jpg", "images/intro/intro-bg-mob.jpg", "фоновая картинка", 1640, 512)
            .intro__main
               .intro__info.intro__info--fourth
                  h2.intro__title Глоссарий
                  p.intro__text #{'В этом разделе собраны основных понятия и термины, относящиеся к сфере технического регулирования, стандартизации, метрологии и менеджмента качества. Глоссарий будет полезен:'}
                     |
                     | — новичкам, которые тратят много времени на освоение профессионального языка;
                     | — опытным сотрудникам, которые по-разному понимают одни и те же термины;
                     | — клиентам для упрощения коммуникации.
                  .intro__bottom
                     +button-icon('link', 'Перейти в раздел')
               .intro__books
                  .intro__books-img
                     +picture("images/intro/intro-06.png", false, "Картинка", 668, 658)