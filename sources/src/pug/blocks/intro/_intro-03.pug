include ../../mixins/_mixins

section.section.section--intro
   .section__wrapper.container
      .section__content
         .intro
            .bg-image
               +picture-simple("images/intro/intro-bg-02.jpg", "images/intro/intro-bg-mob.jpg", "фоновая картинка", 1640, 512)
            .intro__main
               .intro__info.intro__info--center
                  h1.intro__title Бонусная программа
                  p.intro__accent #{'Программа лояльности для подписчиков РИА'} 
                     |
                     | «Стандарты и качество» — это возможность:
                  ul.intro__content #{''}
                     li - получить бесплатный доступ к электронной библиотеке и архиву научных статей издательства;
                     li - задавать вопросы экспертам, и оперативно получать ответ;
                     li - обменять бонусы на рекламу.
                  .intro__bottom
                     +button-icon('link', 'Узнать больше')
               .intro__img
                  +picture-simple("images/intro/intro-05.png", "images/intro/intro-05-mob.png", "Картинка", 874, 603)