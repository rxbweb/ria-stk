include ../../mixins/_mixins

section.section.section--intro
   .section__wrapper.container
      .section__content
         .intro
            .bg-image
               +picture-simple("images/intro/intro-bg.jpg", "images/intro/intro-bg-mob.jpg", "фоновая картинка", 1640, 512)
            .intro__main
               .intro__info.intro__info--center
                  h1.intro__heading Абонементный доступ
                  .intro__bottom
                     +button-icon('link', 'Подробнее')
               .intro__img.intro__img--card
                  +picture-simple("images/intro/intro-02.png", "images/intro/intro-02-mob.png", "Картинка", 1009, 673)