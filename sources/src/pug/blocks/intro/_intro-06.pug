include ../../mixins/_mixins

section.section.section--intro
   .section__wrapper.container
      .section__content
         .intro.intro--third
            .bg-image
               +picture-simple("images/intro/intro-bg-02.jpg", "images/intro/intro-bg-mob.jpg", "фоновая картинка", 1640, 512)
            .intro__main
               .intro__info.intro__info--third
                  h1.intro__title Обучение
                  p.intro__content На этой странице представлена актуальная информация об обучающих курсах и семинарах, которые проводят партнеры РИА «Стандарты и качество».  Если вы не нашли курс на интересующую тему, свяжитесь с нами, мы поможем его организовать.
                  p.intro__notice Заказать корпоративный или индивидуальный семинар:
                     span #[a(href="tel:+74957716652") тел. +7 (495) 771-66-52], #[a(href="mailto:abc@mirq.ru") e-mail: abc@mirq.ru]
                  p.intro__notice #{'Подписывайтесь на журналы РИА «Стандарты и качество»'}
                     |
                     | и получайте скидку на обучение.  С нами выгодно!
                  .intro__bottom
                     +button-icon('link', 'Подписаться')
               .intro__specialists
                  .intro__specialists-img
                     +picture("images/intro/intro-04.png", "images/intro/intro-04-mob.png", "Картинка", 700, 752)