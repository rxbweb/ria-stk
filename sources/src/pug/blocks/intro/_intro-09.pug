include ../../mixins/_mixins

section.section.section--intro
   .section__wrapper.container
      .section__content
         .intro.intro--third
            .bg-image
               +picture-simple("images/intro/intro-bg.jpg", "images/intro/intro-bg-mob.jpg", "фоновая картинка", 1640, 512)
            .intro__main
               .intro__info.intro__info--fourth
                  h2.intro__title Не нашли интересующую подборку?
                  .intro__row
                     p.intro__description Поищите статью в нашей #[br] электронной библиотеке
                     +button-icon('link', 'Перейти в раздел')
               .intro__img
                  .intro__img--macbook
                     +picture("images/intro/intro-08.png", "images/intro/intro-08-mob.png", "Картинка", 734, 453)