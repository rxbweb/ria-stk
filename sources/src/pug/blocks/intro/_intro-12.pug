include ../../mixins/_mixins

section.section.section--intro
   .section__wrapper.container
      .section__content
         .intro
            .bg-image
               +picture-simple("images/intro/intro-bg.jpg", "images/intro/intro-bg-mob.jpg", "фоновая картинка", 1640, 512)
            .intro__main
               .intro__info.intro__info--third
                  h1.intro__title Ловите выгоду!
                  ul.intro__list
                     li Подписывайтесь на год и экономьте до 25% за каждый журнал.
                     li Выбирайте комплект журналов и экономьте еще до 15%.
               .intro__img
                  +picture-simple("images/intro/intro-01.png", "images/intro/intro-01-mob.png", "Картинка", 795, 795)