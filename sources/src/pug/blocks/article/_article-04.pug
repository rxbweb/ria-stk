include ../../mixins/_mixins

-
   const articleTiding = [
      {
         img: 'images/tidings/tidings-01.jpg',
         time: '22 ноября 2024',
         datetime: '2024-11-22',
         title: 'Лауреатов Национальной премии «Бренд года в России 2024» наградили 20 ноября в Москве',
         text: 'В торжественной обстановке награды вручили лауреатам в более чем ста отраслевых и специальных номинациях. Как сообщают в пресс-центре премии, всего на конкурс поступило свыше пятисот заявок.'
      },
      {
         img: 'images/tidings/tidings-02.jpg',
         time: '14 октября 2024',
         datetime: '2024-10-14',
         title: 'Прошло третье мероприятие Бренд-клуба премии «Бренд года в России 2024»',
         text: 'В третий раз Бренд-клуб Национальной премии «Бренд года в России 2024» собрал участников конкурса в Москве на площадке Старт Хаб на «Красном Октябре». На встрече присутствовали члены жюри, представители брендов, резиденты и представители компаний-номинантов премии.'
      },
      {
         img: 'images/tidings/tidings-03.jpg',
         time: '16 сентября 2024',
         datetime: '2024-09-16',
         title: 'Названы номинанты третьего отборочного этапа премии «Бренд года в России 2024»',
         text: 'Оргкомитет Национальной премии «Бренд года в России 2024» подвёл результаты третьего отборочного этапа. Претендентами на победу объявлены еще 30 отечественных брендов.'
      },
      {
         img: 'images/tidings/tidings-04.jpg',
         time: '15 августа 2024',
         datetime: '2024-08-15',
         title: 'Встреча участников клуба премии «Бренд года в России 2024»',
         text: '13 августа на площадке Старт Хаб арт-кластера «Красный Октябрь» состоялась вторая встреча участников Бренд-клуба Национальной премии «Бренд года в России 2024». Команда премии была рада возможности презентовать новые номинации конкурса.'
      },
      {
         img: 'images/tidings/tidings-05.jpg',
         time: '17 июля 2024',
         datetime: '2024-07-17',
         title: 'Журнал Business Excellence стал номинантом второго отборочного этапа премии «Бренд года в России 2024»',
         text: 'Оргкомитет Национальной премии «Бренд года в России 2024» подвёл итоги рассмотрения конкурсных заявок второго отборочного этапа. Претендентами на победу объявлены еще 26 отечественных бренда.'
      },
   ]

article.section.section--article
   .section__wrapper.container
      .section__content
         .article
            .article__inner
               .article__body
                  .article__header.article__header--secondary
                     .article__top
                        .tags
                           .tags__button.tags__button--2
                              time(datetime="2024-11-20") 20 ноября 2024
                        .socials
                           .socials__box
                              p.socials__text Поделиться:
                              .socials__list
                                 a.socials__link(href="#")
                                    +svg('icon-vk', '', 29, 29)
                                 a.socials__link(href="#")
                                    +svg('icon-telegram', '', 29, 29)
                                 a.socials__link(href="#")
                                    +svg('icon-whatsapp', '', 29, 29)
                     h1.article__title Журнал Business Excellence назван брендом года в России
                  .article__box
                     figure.article__figure.article__figure--secondary
                        a.article__figure-picture(href="images/article/article-05.jpg" data-fancybox)
                           +picture("images/article/article-05.jpg", false, "картинка", 504, 500)
                        figcaption.article__figcaption Источник фото
                     p 20 ноября в Москве были объявлены лауреаты Национальной премии «Бренд года в России 2024». Торжественная церемония награждения прошла в легендарном Демонстрационном зале ГУМа. Победителем в номинации «СМИ и издательский бизнес» в престижной категории «Высшая Лига» стал журнал Business Excellence.
                     p Для редакции журнала это заслуженная и долгожданная победа. С 1996 года издание помогает читателям находить новые возможности для бизнеса и обходить конкурентов, предлагая набор эффективных инструментов и бизнес-идей для непрерывного совершенствования как небольших компаний, так и крупных корпораций. Эксклюзивные интервью с топ-менеджерами российских и зарубежных компаний, успешные кейсы и готовые бизнес-решения — то, что отличает журнал и помогает не только сохранять, но и постоянно расширять аудиторию.
                     p Героями Business Excellence выступали такие выдающиеся люди, как: строительный магнат, 45-й президент США Дональд Трамп, легендарный бизнесмен Ричард Брэнсон, генеральный директор Mail.ru Дмитрий Гришин, создатель корпорации Microsoft Билл Гейтс, президент холдинга «Ромир» Андрей Милехин, президент Всероссийской организации качества Геннадий Воронин, президент Бизнес-школы РСПП Евгения Шохина, региональный директор по России и странам СНГ Lufthansa Group Рональд Шульц, вице-президент международной Академии качества Тито Конти, легендарный гуру менеджмента Ицхак Адизес, основоположник современной теории управления маркетингом Филип Котлер, директор по развитию X5 Retail Group Гаррет Джонстон, сооснователь корпорации Apple Стив Возняк и многие другие.
                     p В торжественной обстановке заветная статуэтка была вручена исполнительному директору РИА «Стандарты и качество» Алексею Анискину и главному редактору издательства Татьяне Киселевой. На церемонии награждения также присутствовали руководитель отдела маркетинга Андрей Колесников и директор по связям с общественностью Мария Жукова.
                     p Присуждение Национальной премии «Бренд года в России 2024» журналу Business Excellence является подтверждением соответствия самым высоким стандартам качества в деле обеспечения информационных потребностей предпринимательства и формирования корпоративной базы знаний.
                     p Национальная премия «Бренд года в России» — общественно-значимый проект по признанию и поддержке компаний, которые активно работают на российском рынке. Миссия премии — признать и наградить бренды-лидеры, которые определяют сейчас и будут определять в будущем траекторию развития рынка и страны.
                  .article__box
                     h2.article__caption Другие новости
                     .tidings
                        ul.tidings__list.tidings__list--scroll
                           each tiding in articleTiding
                              li.tidings__item
                                 if tiding.img
                                    .tidings__content
                                       a.tidings__img(href=tiding.img data-fancybox data-caption=`<p class="fancybox__caption-title">${tiding.title}</p> <p class="fancybox__caption-text"><time ${tiding.datetime}>${tiding.time}</time></p>`)
                                          +picture(tiding.img, false, "картинка", 280, 230)
                                 .tidings__info
                                    if tiding.time
                                       time.tidings__date(datetime=tiding.datetime)= tiding.time
                                    if tiding.title
                                       h3.tidings__title= tiding.title
                                    if tiding.text
                                       .tidings__text 
                                          p= tiding.text
                                    +button-outline('link', 'Читать далее')