include ../mixins/_mixins

header.header
   .header__inner
      .header__container.container
         .header__top
            a.header__logo(href="/")
               img.header__logo-main(src="images/icons/logo.svg", alt="логотип" width="178" height="50")
               img.header__logo-vok(src="images/icons/vok.png", alt="вок" width="48" height="48")
            .header__manage
               .header__search.search
                  button.search__button(aria-label="кнопка поиска")
                     svg(width="26" height="26")
                        use(href='images/sprites/main.stack.svg#svg-icon-loop')
                  input.search__input(type="text" placeholder="Искать....")
                  .search__select
                     +select(true, ['Везде', 'По журналам', 'По книгам', 'По статьям', 'По новостям', 'По мероприятиям'])
               +select(true, ['RU', 'EN'], 'select--lang')
            .header__socials.socials
               .socials__list.socials__list--first
                  a.socials__link(href="#")
                     img(src="images/icons/socials-vk.svg", alt="vkontakte" width="26" height="26")
                  a.socials__link(href="#")
                     img(src="images/icons/socials-tg.svg", alt="telegram" width="26" height="26")
                  a.socials__link(href="#")
                     img(src="images/icons/socials-yt.svg", alt="youtube" width="26" height="26")
                  a.socials__link(href="#")
                     img(src="images/icons/socials-dzen.svg", alt="dzen" width="26" height="26")
               .socials__list.socials__list--second
                  a.socials__link(href="mailto:editor_site@mirq.ru?&subject=Заголовок%20письма&body=Содержимое%20письма")
                     img(src="images/icons/socials-mail.svg", alt="mail" width="26" height="26")
                     span editor_site@mirq.ru
                  a.socials__link(href="tel:+74957716652")
                     img(src="images/icons/socials-phone.svg", alt="phone" width="26" height="26")
                     span +7 (495) 771 6652
            .header__controls
               .header__basket
                  a.header__button(href="#")
                     +svg('icon-cart', '', 22, 22)
                  .header__basket-amount 99
               a.header__favorite(href="#")
                  +svg('icon-heart', '')
               .header__login
                  .header__login-btn
                     +svg('icon-user', '', 20, 20)
                     span.header__login-text Войти
               a.header__toggle(href="#" aria-label="открыть меню")
                  .header__toggle-icon
                     span
         .header__bottom
            nav.header__nav
               ul.header__nav-list
                  li.header__nav-item
                     a.is-icon(href="#")
                        svg(width="26" height="26")
                           use(href='images/sprites/main.stack.svg#svg-icon-text')
                        span Подписка
                  li.header__nav-item
                     a(href="#") Журналы
                  li.header__nav-item
                     a(href="#") Спецвыпуски
                  li.header__nav-item
                     a(href="#") Электронная библиотека
                  li.header__nav-item
                     a(href="#") Абонентский доступ
                  li.header__nav-item
                     a(href="#") Услуги
                  li.header__nav-item
                     a(href="#") Мероприятия
                  li.header__nav-item
                     a(href="#") О нас
                  li.header__nav-item
                     a(href="#") Контакты
            button.header__burger(aria-label="открыть дополнительное меню")
               span
               span
               span
         .header__box
            ul.header__box-nav

.menu
   .menu__inner
      .menu__container.container
         .menu__manage
            .menu__search.search
               button.search__button(aria-label="кнопка поиска")
                  svg(width="26" height="26")
                     use(href='images/sprites/main.stack.svg#svg-icon-loop')
               input.search__input(type="text" placeholder="Искать....")
               .search__select
                  +select(true, ['Везде', 'По журналам', 'По книгам', 'По статьям', 'По новостям', 'По мероприятиям'])
            +select(true, ['RU', 'EN'], 'select--lang')
         nav.menu__nav
            ul.menu__nav-list
               li
                  a.is-icon(href="#")
                     svg(width="22" height="22")
                        use(href='images/sprites/main.stack.svg#svg-icon-text')
                     span Подписка
               li
                  a(href="#") Журналы
               li
                  a(href="#") Спецвыпуски
               li
                  a(href="#") Электронная библиотека
               li
                  a(href="#") Абонементный доступ
               li
                  a(href="#") Услуги
               li
                  a(href="#") Мероприятия
               li
                  a(href="#") О нас
               li
                  a(href="#") Контакты
         .menu__logo
            img(src="images/icons/vok.png", alt="вок" width="48" height="48")
         .menu__socials.socials
            .socials__list
               a.socials__link(href="#")
                  img(src="images/icons/socials-vk.svg", alt="vkontakte" width="26" height="26")
               a.socials__link(href="#")
                  img(src="images/icons/socials-tg.svg", alt="telegram" width="26" height="26")
               a.socials__link(href="#")
                  img(src="images/icons/socials-yt.svg", alt="youtube" width="26" height="26")
               a.socials__link(href="#")
                  img(src="images/icons/socials-dzen.svg", alt="dzen" width="26" height="26")
            .socials__list.socials__list--second
               a.socials__link(href="mailto:editor_site@mirq.ru")
                  img(src="images/icons/socials-mail.svg", alt="mail" width="26" height="26")
                  span editor_site@mirq.ru
               a.socials__link(href="tel:+74957716652")
                  img(src="images/icons/socials-phone.svg", alt="phone" width="26" height="26")
                  span +7 (495) 771 6652