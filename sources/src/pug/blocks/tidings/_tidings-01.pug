include ../../mixins/_mixins

-
   const tidings01 = [
      {
         img: 'images/article/tidings-01.jpg',
         time: '22 ноября 2024',
         datetime: '2024-11-22',
         title: 'Лауреатов Национальной премии «Бренд года в России 2024» наградили 20 ноября в Москве',
         text: 'В торжественной обстановке награды вручили лауреатам в более чем ста отраслевых и специальных номинациях. Как сообщают в пресс-центре премии, всего на конкурс поступило свыше пятисот заявок.'
      },
      {
         img: 'images/article/tidings-02.jpg',
         time: '14 октября 2024',
         datetime: '2024-10-14',
         title: 'Прошло третье мероприятие Бренд-клуба премии «Бренд года в России 2024»',
         text: 'В третий раз Бренд-клуб Национальной премии «Бренд года в России 2024» собрал участников конкурса в Москве на площадке Старт Хаб на «Красном Октябре». На встрече присутствовали члены жюри, представители брендов, резиденты и представители компаний-номинантов премии.'
      },
      {
         img: 'images/article/tidings-03.jpg',
         time: '16 сентября 2024',
         datetime: '2024-09-16',
         title: 'Названы номинанты третьего отборочного этапа премии «Бренд года в России 2024»',
         text: 'Оргкомитет Национальной премии «Бренд года в России 2024» подвёл результаты третьего отборочного этапа. Претендентами на победу объявлены еще 30 отечественных брендов.'
      },
      {
         img: 'images/article/tidings-04.jpg',
         time: '15 августа 2024',
         datetime: '2024-08-15',
         title: 'Встреча участников клуба премии «Бренд года в России 2024»',
         text: '13 августа на площадке Старт Хаб арт-кластера «Красный Октябрь» состоялась вторая встреча участников Бренд-клуба Национальной премии «Бренд года в России 2024». Команда премии была рада возможности презентовать новые номинации конкурса.'
      },
      {
         img: 'images/article/tidings-05.jpg',
         time: '17 июля 2024',
         datetime: '2024-07-17',
         title: 'Журнал Business Excellence стал номинантом второго отборочного этапа премии «Бренд года в России 2024»',
         text: 'Оргкомитет Национальной премии «Бренд года в России 2024» подвёл итоги рассмотрения конкурсных заявок второго отборочного этапа. Претендентами на победу объявлены еще 26 отечественных бренда.'
      },
   ]

.tidings
   ul.tidings__list
      each tiding in tidings01
         li.tidings__item
            if tiding.img
               .tidings__content
                  a.tidings__img(href=tiding.img data-fancybox data-caption=`<p class="fancybox__caption-title">${tiding.title}</p> <p class="fancybox__caption-text"><time ${tiding.datetime}>${tiding.time}</time></p>`)
                     +picture(tiding.img, false, "картинка", 280, 230)
            .tidings__info
               if tiding.time
                  time.tidings__date(datetime=tiding.datetime)= tiding.time
               if tiding.title
                  h3.tidings__title= tiding.title
               if tiding.text
                  .tidings__text 
                     p= tiding.text
               +button-outline('link', 'Читать далее')