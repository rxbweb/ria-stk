section.section.section--tidings
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Новости
         .section__header-manage
            .search
               button.search__button(aria-label="кнопка поиска")
                  svg(width="26" height="26")
                     use(href='images/sprites/main.stack.svg#svg-icon-loop')
               input.search__input(type="text" placeholder="Искать....")
            +select(true, ['10 октября - По настоящее время', '11 октября - По настоящее время', '12 октября - По настоящее время'])
         .section__header-bottom
            .tags
               a.tags__button(href="#") Название тегов длинного тега
               a.tags__button(href="#") Название тегов
               a.tags__button(href="#") Название тегов
