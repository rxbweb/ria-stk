include ../mixins/_mixins

section.section.section--status
   .section__wrapper.container
      .section__content
         .status
            .bg-image
               +picture-simple("images/status/status-bg.jpg", "images/status/status-bg-mob.jpg", "фоновая картинка", 1640, 500)
            .status__inner
               .status__row
                  .status__info
                     h2.status__title Хотите подтвердить свой экспертный статус?
                     p.status__text Станьте автором журналов РИА «Стандарты и качество». Ждем как опытных, так и начинающих специалистов. Важна польза и подача материала. Приоритет отдается статьям практической направленности.
                     +button-icon('link', 'Подробнее')
                  .status__img
                     +picture("images/status/status-img.png", false, "картинка", 570, 500)