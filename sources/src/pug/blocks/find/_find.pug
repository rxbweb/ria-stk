section.section.section--find
   .section__wrapper.container
      .section__content
         .find
            .find__inner
               .find__header
                  h1.find__title Результаты поиска
                  .find__results Результаты выдачи по запросу #[a(href="#") «СМК»]. Фильтр #[a(href="#") «Везде»]
               ul.find__list
                  each item in findResults
                     li.find__item
                        a.find__link(href="#")
                           .find__img
                              if item.img
                                 +picture(item.img, false, item.title)
                              else
                                 img.find__img-icon(src="images/icons/photo.svg" alt="нет картинки" width="96" height="96")
                           .find__info
                              p.find__type #{item.type}
                              h3.find__name #{item.title}
                              ul.find__table
                                 each value in item.listing
                                    li!= value
               include ../pagination/_pagination