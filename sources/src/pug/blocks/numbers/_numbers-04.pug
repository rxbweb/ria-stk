-
   const numbers04 = [
      {
         num: '12 000+',
         text: 'Статей в фонде библиотеки'
      },
      {
         num: '2 500+',
         text: 'Авторов и экспертов со всего мира'
      },
      {
         num: '1 500+',
         text: 'Пользователей ежедневно'
      },
      {
         num: '24/7',
         text: 'Круглосуточная доступность'
      },
   ]

section.section.section--padding-small.section--numbers-2
   .section__wrapper.container
      .section__content
         .numbers
            .numbers__inner
               ul.numbers__list.numbers__list--4
                  each number in numbers04
                     li.numbers__item
                        .numbers__num=number.num
                        .numbers__text!=number.text