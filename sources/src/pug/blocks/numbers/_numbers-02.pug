-
   const numbers02 = [
      {
         num: '12',
         text: 'Отраслевых <br> комитета'
      },
      {
         num: '100',
         plus: '+',
         text: 'Партнерских <br> организаций'
      },
      {
         num: '1000',
         text: 'Членов <br> организации'
      },
      {
         num: '73',
         text: 'Отделения <br> по всей России'
      },
   ]

section.section.section--padding-small.section--numbers-2
   .section__wrapper.container
      .section__content
         .numbers
            .numbers__inner
               ul.numbers__list.numbers__list--4
                  each number in numbers02
                     li.numbers__item(data-nums)
                        .numbers__num
                           span(data-value=number.num)
                           if number.plus
                              = number.plus
                        .numbers__text!=number.text