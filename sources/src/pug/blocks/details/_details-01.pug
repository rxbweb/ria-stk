include ../../mixins/_mixins

section.section.section--details
      .section__wrapper.container
         .section__header
            .section__header-row
               h2.section__header-title Мероприятия
               +button-icon('link', 'Посмотреть все мероприятия', 'section__header-button')
         .section__content
            .details
               .details__inner
                  ul.details__list
                     li.details__list-item
                        a.details__list-box(href="#")
                           .details__list-img
                              img(src="images/details/details-01.jpg", alt="Общероссийская общественная премия «Стандартизатор года — 2024»" width="520" height="292")
                           .details__list-info
                              h3.details__list-title Общероссийская общественная премия «Стандартизатор года — 2024»
                              .details__list-text
                                 p Место проведения: Город, Адрес, улица номер дома зала или офиса.
                              .details__list-tags.tags
                                 .tags__button Тег мероприятия: например выставка
                              p.details__list-description #{'29 октября – '}
                                 |
                                 | 6 ноября 2024
                              +button-outline('div', 'Подробнее', 'details__list-button')
                     li.details__list-item
                        a.details__list-box(href="#")
                           .details__list-img
                              img(src="images/details/details-02.jpg", alt="Форум «Российская неделя стандартизации»" width="520" height="292")
                           .details__list-info
                              h3.details__list-title Форум «Российская неделя стандартизации»
                              .details__list-text
                                 p Место проведения: Город, Адрес, улица номер дома зала или офиса.
                              .details__list-tags.tags
                                 .tags__button Тег мероприятия: например выставка
                              p.details__list-description #{'14 октября – '}
                                 |
                                 | 21 октября 2024
                              +button-outline('div', 'Подробнее', 'details__list-button')
                     li.details__list-item
                        a.details__list-box(href="#")
                           .details__list-img
                              img(src="images/details/details-03.jpg", alt="Форум «Лучший опыт для лучшей жизни»" width="520" height="292")
                           .details__list-info
                              h3.details__list-title Форум «Лучший опыт для лучшей жизни»
                              .details__list-text
                                 p Место проведения: Город, Адрес, улица номер дома зала или офиса.
                              .details__list-tags.tags
                                 .tags__button Тег мероприятия: например выставка
                              p.details__list-description 10 августа 2024
                              +button-outline('div', 'Подробнее', 'details__list-button')

         .section__footer
            +button-icon('link', 'Посмотреть все мероприятия', 'section__footer-button')