include ../../mixins/_mixins

-
   const details05 = [
      {
         img: 'images/details/details-events-07.jpg',
         title: 'Международная промышленная выставка ИННОПРОМ',
         text: [
            'Место проведения: Город Екатеринбург',
         ],
         tags: [
            'Мероприятие',
         ],
         description: '08-11 июля 2024',
      },
      {
         img: 'images/details/details-events-08.jpg',
         title: 'Петербургский международный экономический форум',
         text: [
            'Место проведения: Город Санкт-Петербург',
         ],
         tags: [
            'Мероприятие',
         ],
         description: '05-08 июня 2024',
      },
      {
         img: 'images/details/details-events-09.jpg',
         title: 'IX Ежегодная конференция «Цифровая индустрия промышленной России»',
         text: [
            'Место проведения: Город Нижний Новгород',
         ],
         tags: [
            'Мероприятие',
         ],
         description: '21-24 мая 2024',
      },
   ]

section.section.section--details
      .section__wrapper.container
         .section__header
            .section__header-row
               h2.section__header-title Прошедшие мероприятия
         .section__content
            .details
               .details__inner
                  ul.details__list
                     each detail in details05
                        li.details__list-item
                           a.details__list-box(href="#")
                              if detail.img
                                 .details__list-img
                                    +picture(detail.img, false, detail.title, 520, 292)
                              .details__list-info
                                 if detail.description
                                    p.details__list-description= detail.description
                                 if detail.title
                                    h3.details__list-title= detail.title
                                 if detail.text
                                    .details__list-text
                                       each text in detail.text
                                          p= text
                                 if detail.tags
                                    each tag in detail.tags
                                       .details__list-tags.tags
                                          .tags__button= tag
                                 +button-outline('div', 'Подробнее', 'details__list-button')
                  include ../pagination/_pagination