section.section.section--details
      .section__wrapper.container
         .section__header
            .section__header-row
               h2.section__header-heading Мероприятия
         .section__content
            .details
               .details__inner
                  ul.details__list
                     each detail in details04
                        li.details__list-item
                           a.details__list-box(href="#")
                              if detail.img
                                 .details__list-img
                                    +picture(detail.img, false, detail.title, 520, 292)
                              .details__list-info
                                 if detail.description
                                    p.details__list-description= detail.description
                                 if detail.title
                                    h3.details__list-title= detail.title
                                 if detail.text
                                    .details__list-text
                                       each text in detail.text
                                          p= text
                                 if detail.tags
                                    each tag in detail.tags
                                       .details__list-tags.tags
                                          .tags__button= tag
                                 +button-outline('link', 'Подробнее', 'details__list-button')
                  include ../pagination/_pagination