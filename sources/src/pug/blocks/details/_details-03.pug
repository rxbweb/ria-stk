include ../../mixins/_mixins

section.section.section--details
      .section__wrapper.container
         .section__header
            .section__header-row
               h2.section__header-title Доступные виды рекламы
         .section__content
            .details
               .details__inner
                  ol.details__list.details__list--advert
                     li.details__list-item
                        .details__list-box
                           .details__list-info
                              h3.details__list-title Модульная реклама
                              .details__list-text
                                 p Привлекает внимание читателей за счет графики. Может быть выполнена с использованием дополнительных полиграфических возможностей (более плотная бумага, выборочное лакирование, конверт, раскладные страницы и пр.).
                              .details__list-manage
                                 p.details__list-price От 79 500 руб.
                                 +button-icon('link', 'Связаться')
                           ul.details__list-images
                              li
                                 img(src="images/details/details-images-01.png", alt="Модульная реклама" width="219" height="309")
                              li
                                 img(src="images/details/details-images-02.png", alt="Модульная реклама" width="219" height="309")
                              li
                                 img(src="images/details/details-images-03.png", alt="Модульная реклама" width="219" height="309")
                     li.details__list-item
                        .details__list-box
                           .details__list-info
                              h3.details__list-title Текстовая реклама
                              .details__list-text
                                 p Позволяет представить вас/вашу компанию в качестве эксперта. Форматы: интервью, рекламная статья, обзор, экспертный материал.
                              .details__list-manage
                                 p.details__list-price От 135 100 руб.
                                 +button-icon('link', 'Связаться')
                           ul.details__list-images
                              li
                                 img(src="images/details/details-images-04.png", alt="Текстовая реклама" width="219" height="309")
                              li
                                 img(src="images/details/details-images-05.png", alt="Текстовая реклама" width="219" height="309")
                              li
                                 img(src="images/details/details-images-06.png", alt="Текстовая реклама" width="219" height="309")
                     li.details__list-item
                        .details__list-box
                           .details__list-info
                              h3.details__list-title Интервью с фото спикера на обложке
                              .details__list-text
                                 p Интервью с представителем топ-менеджмента компании. Об опыте первых лиц бизнеса. О том, как правильно и эффективно определить генеральные направления развития компаний. На обложке номера — фото спикера.
                              .details__list-manage
                                 p.details__list-price 520 000 руб.
                                 +button-icon('link', 'Связаться')
                           ul.details__list-images
                              li
                                 img(src="images/details/details-images-07.png", alt="Интервью с фото спикера на обложке" width="219" height="309")
                              li
                                 img(src="images/details/details-images-08.png", alt="Интервью с фото спикера на обложке" width="219" height="309")
                              li
                                 img(src="images/details/details-images-09.png", alt="Интервью с фото спикера на обложке" width="219" height="309")
                     li.details__list-item
                        .details__list-box
                           .details__list-info
                              h3.details__list-title Брендирование
                              .details__list-text
                                 p Брендирование — оформление в фирменных цветах компании-рекламодателя, нанесение логотипа. Брендирование статьи, раздела или выпуска.
                              .details__list-manage
                                 p.details__list-price От 100 000 руб. #[br] Рассчитывается индивидуально
                                 +button-icon('link', 'Связаться')
                           ul.details__list-images
                              li
                                 img(src="images/details/details-images-10.png", alt="Брендирование" width="219" height="309")
                              li
                                 img(src="images/details/details-images-11.png", alt="Брендирование" width="219" height="309")
                              li
                                 img(src="images/details/details-images-12.png", alt="Брендирование" width="219" height="309")
                     li.details__list-item
                        .details__list-box
                           .details__list-info
                              h3.details__list-title Вложения
                              .details__list-text
                                 p Рекламные вложения в журнал (листовки, закладки, календари и пр.).
                              .details__list-manage
                                 p.details__list-price 1 000 шт. — от 70 тыс. руб.
                                 +button-icon('link', 'Связаться')
                           ul.details__list-images
                              li
                                 img(src="images/details/details-images-13.png", alt="Вложения" width="266" height="266")
                              li
                                 img(src="images/details/details-images-14.png", alt="Вложения" width="198" height="266")
                              li
                                 img(src="images/details/details-images-15.png", alt="Вложения" width="198" height="266")
                     li.details__list-item
                        .details__list-box
                           .details__list-info
                              h3.details__list-title Спецвыпуск на заказ
                              .details__list-text
                                 p Заказ и подготовка спецвыпуска — это всегда индивидуальный проект: самая мощная имиджевая реклама. Выпуск может состоять из ваших материалов полностью или частично.
                                 p Минимальный тираж от 100 экземпляров.
                                 p Срок подготовки спецвыпуска от 25-30 дней.

                              .details__list-manage
                                 p.details__list-price Стоимость рассчитывается индивидуально
                                 +button-icon('link', 'Связаться')
                           ul.details__list-images.details__list-images--large
                              li
                                 img(src="images/details/details-images-16.jpg", alt="Спецвыпуск на заказ" width="700" height="360")
                     li.details__list-item
                        .details__list-box
                           .details__list-info
                              h3.details__list-title Дополнительные возможности
                              .details__list-text
                                 p Рекламные публикации с использованием дополнительных полиграфических возможностей — более плотная бумага, выборочное лакирование, конверт, раскладные страницы и пр.
                              .details__list-manage
                                 p.details__list-price Стоимость рассчитывается индивидуально
                                 +button-icon('link', 'Связаться')
                           ul.details__list-images
                              li
                                 img(src="images/details/details-images-17.png", alt="Дополнительные возможности" width="173" height="244")
                              li
                                 img(src="images/details/details-images-18.png", alt="Дополнительные возможности" width="320" height="244")
                              li
                                 img(src="images/details/details-images-19.png", alt="Дополнительные возможности" width="171" height="244")