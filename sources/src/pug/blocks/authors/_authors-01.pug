section.section.section--authors
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Авторы
      .section__content
         .authors
            .authors__inner
               ul.authors__list
                  each author in authors01
                     li.authors__item
                        .authors__top
                           if author.label
                              .authors__label
                                 .authors__label-img
                                    img(src=author.label.src, alt="иконка" width="24" height="28")
                                 span.authors__label-text= author.label.text
                           .authors__img
                              img(src=author.photo, alt=author.name, width="256" height="310")
                        .authors__info
                           p.authors__description= author.description
                           p.authors__name= author.name
                           a.button.button--outline(href="#")
                              span Подробнее
                              i.icon.icon-arrow-small