-
   const authors02 = [
      {
         label: {
            src: 'images/badges/badge-14.svg',
            text: 'Эксперт журнала'
         },
         photo: 'images/authors/authors-01.jpg',
         description: 'профессор МГИМО',
         name: 'Аронов Иосиф Зиновьевич'
      },
      {
         photo: 'images/authors/authors-02.jpg',
         description: 'Доктор техн. наук',
         name: 'Лапидус Вадим Аркадьевич'
      },
      {
         photo: 'images/authors/authors-04.jpg',
         description: 'профессор МГИМО',
         name: 'Фалкин Дмитрий Владимирович'
      },
      {
         label: {
            src: 'images/badges/badge-14.svg',
            text: 'Эксперт журнала'
         },
         photo: 'images/authors/authors-03.jpg',
         description: 'Профессор МИСИС',
         name: 'Адлер Юрий Павлович'
      }
   ]


section.section.section--authors
   .section__wrapper.container
      .section__content
         .authors
            .authors__inner
               .authors__row
                  .authors__aside
                     h2.authors__title Авторы журнала
                  .authors__content
                     ul.authors__list.authors__list--3
                        each author in authors02
                           li.authors__item
                              .authors__top
                                 if author.label
                                    .authors__label
                                       .authors__label-img
                                          img(src=author.label.src, alt="иконка" width="24" height="28")
                                       span.authors__label-text= author.label.text
                                 .authors__img
                                    img(src=author.photo, alt=author.name, width="256" height="310")
                              .authors__info
                                 p.authors__description= author.description
                                 p.authors__name= author.name
                                 a.button.button--outline(href="#")
                                    span Подробнее
                                    i.icon.icon-arrow-small