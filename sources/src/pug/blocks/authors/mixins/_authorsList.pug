include ../../../mixins/_mixins

mixin authorsList(authors)   
   ul.authors__list
      each author in authors01
         li.authors__item
            if author.label || author.photo
               .authors__top
                  if author.label === true
                     .authors__label
                        .authors__label-img
                           svg(width="28" height="32")
                              use(href="images/sprites/main.stack.svg#svg-badge-14")
                        span.authors__label-text Эксперт журнала
                  if author.photo
                     .authors__img
                        +picture(author.photo, false, author.name, 256, 310)
            if author.description || author.name
               .authors__info
                  if author.description
                     p.authors__description= author.description
                  if author.name
                     p.authors__name= author.name
                  +button-outline('link', 'Подробнее')