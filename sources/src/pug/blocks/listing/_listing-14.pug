include ../../mixins/_mixins

-
   const listings14 = [
      {
         title: 'Реклама в журналах',
         img: 'images/listing/listing-11.jpg'
      },
      {
         title: 'Реклама на сайте',
         img: 'images/listing/listing-12.jpg'
      }
   ]

.listing
   ol.listing__list.listing__list--2
      each listing in listings14
         li.listing__item
            a.listing__box(href="#")
               h3.listing__name=listing.title
               .listing__img
                  +picture(listing.img, false, "картинка", 350, 222)