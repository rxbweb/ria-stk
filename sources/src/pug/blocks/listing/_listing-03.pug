include ../../mixins/_mixins

-
   const listings03 = [
      {
         badge: 'badge-10',
         title: 'Регулярное поступление актуальной информации'
      },
      {
         badge: 'badge-11',
         title: 'Постоянный и непрерывный процесс совершенствования компетенций'
      },
      {
         badge: 'badge-12',
         title: 'Формирование корпоративной базы знаний'
      },
      {
         badge: 'badge-13',
         title: 'Доступ к системе привилегий'
      },
   ]

section.section.section--listing
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Преимущества подписки
            +button-icon('link', 'Подписка', 'section__header-button')
      .section__content
         .listing
            .listing__inner
               ul.listing__list.listing__list--4.listing__list--default
                  each listing in listings03
                     li.listing__item
                        .listing__box
                           .badge.badge--large
                              +svg(listing.badge, '', 40, 40)
                           h3.listing__name=listing.title
      .section__footer
         +button-icon('link', 'Подписка')