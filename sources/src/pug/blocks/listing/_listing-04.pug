-
   const listings04 = [
      {
         title: 'Спецвыпуск журнала',
         image: 'images/listing/listing-adv-01.jpg'
      },
      {
         title: 'Реклама в журналах',
         image: 'images/listing/listing-adv-02.jpg'
      },
      {
         title: 'Реклама на сайте',
         image: 'images/listing/listing-adv-03.jpg'
      },
      {
         title: 'Спецпроект',
         image: 'images/listing/listing-adv-04.jpg'
      }
   ]

section.section.section--listing
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Рекламные возможности
      .section__content
         .listing
            .listing__inner
               ol.listing__list.listing__list--4
                  each listing in listings04
                     li.listing__item
                        a.listing__box(href="#")
                           h3.listing__name=listing.title
                           .listing__img
                              img(src=listing.image, alt="картинка" width="350" height="222")