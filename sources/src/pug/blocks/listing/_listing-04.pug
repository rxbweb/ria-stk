include ../../mixins/_mixins

-
   const listings04 = [
      {
         title: 'Спецвыпуск журнала',
         img: 'images/listing/listing-06.jpg'
      },
      {
         title: 'Реклама в журналах',
         img: 'images/listing/listing-07.jpg'
      },
      {
         title: 'Реклама на сайте',
         img: 'images/listing/listing-08.jpg'
      },
      {
         title: 'Спецпроект',
         img: 'images/listing/listing-09.jpg'
      }
   ]

section.section.section--listing
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Рекламные возможности
      .section__content
         .listing
            .listing__inner
               ol.listing__list.listing__list--4
                  each listing in listings04
                     li.listing__item
                        a.listing__box(href="#")
                           h3.listing__name=listing.title
                           .listing__img
                              +picture(listing.img, false, "картинка", 350, 222)