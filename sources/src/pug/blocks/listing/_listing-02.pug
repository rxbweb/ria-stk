-
   const listings02 = [
      {
         title: 'Электронная библиотека',
         text: 'Миссия РИА «Стандарты и качество» — нести людям идеи качества во всем их многообразии.',
         badge: 'images/badges/badge-08.svg',
         badgeSize: '32',
         image: 'images/listing/listing-mission-01.jpg'
      },
      {
         title: 'Тематические подборки',
         text: 'Глобальный информационный центр, база знаний о качестве — доступный, удобный, информативный.',
         badge: 'images/badges/badge-09.svg',
         badgeSize: '43',
         image: 'images/listing/listing-mission-02.jpg'
      }
   ]

section.section.section--listing
   .section__wrapper.container
      .section__content
         .listing
            .listing__inner
               .listing__row
                  .listing__aside
                     h2.listing__title Миссия и видение компании
                  .listing__content
                     ul.listing__list.listing__list--2
                        each listing in listings02
                           li.listing__item
                              a.listing__box(href="#")
                                 .badge.badge--large
                                    img(src=listing.badge, alt="иконка" width=listing.badgeSize height=listing.badgeSize)
                                 h3.listing__name=listing.title
                                 p.listing__text=listing.text
                                 .listing__img
                                    img(src=listing.image, alt="картинка" width="350" height="222")