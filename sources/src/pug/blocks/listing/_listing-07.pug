include ../../mixins/_mixins

-
   const listings07 = [
      {
         badge: 'badge-19',
         badgeWidth: '35',
         badgeHeight: '36',
         title: 'Старейшее бизнес-издание современной <br> России — издается с 1996 г.'
      },
      {
         badge: 'badge-20',
         badgeWidth: '40',
         badgeHeight: '46',
         title: 'Площадка для общения и обмена <br> опытом'
      },
      {
         badge: 'badge-21',
         badgeWidth: '44',
         badgeHeight: '42',
         title: 'В каждом номере успешные кейсы <br> и готовые бизнес-решения'
      },
      {
         badge: 'badge-22',
         badgeWidth: '41',
         badgeHeight: '40',
         title: 'Выпускается в печатном и <br> электронном виде'
      },
      {
         badge: 'badge-23',
         badgeWidth: '36',
         badgeHeight: '36',
         title: 'Многократный победитель <br> профессиональных конкурсов'
      },
      {
         badge: 'badge-24',
         badgeWidth: '36',
         badgeHeight: '30',
         title: 'Суммарная аудитория одного <br> выпуска 91 000+ специалистов'
      },
   ]

section.section.section--listing
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Кратко о журнале
      .section__content
         .listing
            .listing__inner
               .listing__content
                  ul.listing__list.listing__list--secondary.listing__list--3.listing__list--default
                     each listing in listings07
                        li.listing__item
                           .listing__box
                              .badge.badge--large
                                 +svg(listing.badge, '', listing.badgeWidth + 2, listing.badgeHeight + 2)
                              h3.listing__name!=listing.title