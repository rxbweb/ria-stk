section.section.section--listing
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Кратко о журнале
      .section__content
         .listing
            .listing__inner
               .listing__content
                  ul.listing__list.listing__list--secondary.listing__list--3
                     each listing in listings07
                        li.listing__item
                           .listing__box
                              .badge.badge--large
                                 img(src=listing.badge, alt="иконка" width=listing.badgeWidth height=listing.badgeHeight)
                              h3.listing__name!=listing.title