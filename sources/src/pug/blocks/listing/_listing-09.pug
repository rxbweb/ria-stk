include ../../mixins/_mixins

-
   const listings09 = [
      {
         badge: 'badge-35',
         badgeWidth: '32',
         badgeHeight: '32',
         title: 'Экспертные  статьи, позволяющие <br> знаниям стать навыками'
      },
      {
         badge: 'badge-36',
         badgeWidth: '40',
         badgeHeight: '40',
         title: 'Междисциплинарный подход <br> к исследованию темы'
      },
      {
         badge: 'badge-37',
         badgeWidth: '34',
         badgeHeight: '34',
         title: 'Авторы, чье  мнение интересно'
      },
      {
         badge: 'badge-38',
         badgeWidth: '41',
         badgeHeight: '40',
         title: 'Печатная и электронная версии <br> журналов и книг'
      },
      {
         badge: 'badge-39',
         badgeWidth: '36',
         badgeHeight: '46',
         title: 'Бонусная система для постоянных <br> подписчиков'
      },
      {
         badge: 'badge-40',
         badgeWidth: '46',
         badgeHeight: '34',
         title: 'Удобные сервисы — электронная библиотека, <br> абонементный доступ и др.'
      },
   ]

section.section.section--listing
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Почему мы?
      .section__content
         .listing
            .listing__inner
               .listing__content
                  ul.listing__list.listing__list--secondary.listing__list--3.listing__list--default
                     each listing in listings09
                        li.listing__item
                           .listing__box
                              .badge.badge--large
                                 +svg(listing.badge, '', listing.badgeWidth + 2, listing.badgeHeight + 2)
                              h3.listing__name!=listing.title