      },
      {
         badge: 'badge-44',
         badgeWidth: '40',
         badgeHeight: '46',
         title: 'Входит в перечень рецензируемых научных изданий ВАК при Минобрнауки России'
      },
      {
         badge: 'badge-24',
         badgeWidth: '44',
         badgeHeight: '42',
         title: 'Учредители Росстандарт, ВОК, <br> РИА «Стандарты и качество»'
      },
      {
         badge: 'badge-45',
         badgeWidth: '41',
         badgeHeight: '40',
         title: 'ВВыпускается в печатном <br> и электронном виде'
      },
      {
         badge: 'badge-23',
         badgeWidth: '36',
         badgeHeight: '36',
         title: 'победитель профессиональных конкурсов, <br> лауреат премии “Золотой фонд российской прессы”'
      },
      {
         badge: 'badge-46',
         badgeWidth: '36',
