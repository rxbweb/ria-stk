include ../../mixins/_mixins

-
   const listings12 = [
      {
         name: 'Архив журналов',
         img: 'images/listing/listing-02.jpg'
      },
      {
         name: 'Библиотека: Статьи и книги',
         img: 'images/listing/listing-10.jpg'
      },
      {
         name: 'Тематические подборки',
         img: 'images/listing/listing-12.jpg'
      }
   ]

section.section.section--listing
   .section__wrapper.container
      .section__content
         .listing
            .listing__inner
               .listing__row
                  .listing__aside
                     h2.listing__title Полезные #[br] материалы
                  .listing__content
                     ol.listing__list
                        each listing in listings12
                           li.listing__item
                              a.listing__box(href="#")
                                 h3.listing__name=listing.name
                                 .listing__img
                                    +picture(listing.img, false, "картинка", 350, 222)