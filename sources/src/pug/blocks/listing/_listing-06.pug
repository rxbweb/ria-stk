section.section.section--listing
   .section__wrapper.container
      .section__header
         .section__header-row
            h2.section__header-title Наши преимущества
      .section__content
         .listing
            .listing__inner
               .listing__content
                  ul.listing__list.listing__list--4.listing__list--default
                     each listing in listings06
                        li.listing__item
                           .listing__box
                              .badge.badge--large
                                 +svg(listing.badge, '', listing.badgeWidth + 2, listing.badgeHeight + 2)
                              h3.listing__name=listing.title