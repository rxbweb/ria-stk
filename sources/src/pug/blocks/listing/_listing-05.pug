-
   const listings05 = [
      {
         text: 'Экспертные статьи, позволяющие знаниям стать навыками',
         badge: 'images/badges/badge-15.svg',
         badgeWidth: '32',
         badgeHeight: '32',
      },
      {
         text: 'Междисциплинарный подход к исследованию темы',
         badge: 'images/badges/badge-16.svg',
         badgeWidth: '34',
         badgeHeight: '32',
      },
      {
         text: 'Авторы, чье <br> мнение интересно',
         badge: 'images/badges/badge-17.svg',
         badgeWidth: '34',
         badgeHeight: '34',
      },
      {
         text: 'Образцы лучших <br> практик',
         badge: 'images/badges/badge-18.svg',
         badgeWidth: '36',
         badgeHeight: '36',
      },
   ]

section.section.section--listing
   .section__wrapper.container
      .section__content
         .listing
            .listing__inner
               .listing__row
                  .listing__aside.listing__aside--big
                     h2.listing__title Наши преимущества
                  .listing__content
                     ul.listing__list.listing__list--secondary.listing__list--default
                        each listing in listings05
                           li.listing__item
                              .listing__box
                                 .badge.badge--large
                                    img(src=listing.badge, alt="иконка" width=listing.badgeWidth height=listing.badgeHeight)
                                 h3.listing__name!=listing.text