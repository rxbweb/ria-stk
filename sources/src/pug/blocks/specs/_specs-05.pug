include ../../mixins/_mixins

section.section.section--padding-top-none.section--sidebar.section--specs
   .section__wrapper
      .section__content
         .specs.specs--2
            .bg-image
               +picture("images/global/global-bg.jpg", "images/global/global-bg-mob.jpg", "фоновая картинка", 1920, 640)
            .specs__inner.container
               +breadcrumbs([
                  { href: '#', title: 'Главная' },
                  { href: '#', title: 'Журналы' },
                  { href: '#', title: 'Страница журнала' },
               ])
               .specs__controls
                  include ../sidebar/_sidebar
                  +sidebar()
               .specs__box
                  .specs__img
                     img(src="images/specs/specs-05.png", alt="Стандарты и качество")
                  .specs__info
                     p.specs__lead Стандарты и качество
                     h1.specs__name.specs__name--large № 10/2023 (октябрь)
                     ul.specs__table
                        li Международный стандарт ISO/TS 19677:2019. Совершенствование лесного законодательства
                        li Странный государственный стандарт
                        li Циркулярная экономика начинается с упаковки. Обзор стратегий
                     .specs__manage
                        +button-icon('link', 'Подписаться на журнал', 'button--wide', '')
                        +button-outline('link', 'Купить в 1 клик')