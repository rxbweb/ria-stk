include ../../mixins/_mixins

section.section.section--padding-top-none.section--specs
   .section__wrapper
      .section__content
         .specs.specs--2
            .bg-image
               +picture("images/global/global-bg.jpg", "images/global/global-bg-mob.jpg", "фоновая картинка", 1920, 640)
            .specs__inner.container
               +breadcrumbs([
                  { href: '#', title: 'Главная' },
                  { href: '#', title: 'Книги' },
                  { href: '#', title: 'Цифровое качество. Свод знаний о цифровой трансформации' }
               ])
               .specs__box
                  .specs__img
                     img(src="images/specs/specs-01.png", alt="Цифровое качество. Свод знаний о цифровой трансформации" width="310" height="428")
                  .specs__info
                     p.specs__lead ISBN 978-5-04-101730-9
                     h1.specs__name Цифровое качество. Свод знаний о цифровой трансформации
                     ul.specs__table
                        li #[span Автор(ы)] Чекмарев А.В., Азаров В.Н., Куприянов Ю.В.
                        li #[span Год выпуска] 2024
                        li #[span Издательский дом] Н.П. Пастухова
                        li #[span Число страниц:] 500
                        li #[span Версия:] Печатная
                     .specs__manage
                        p.specs__price 5 600 руб.
                        +button-icon('link', 'Скачать медиа-кит', 'button--wide', 'icon-cart')
                        +button-outline('link', 'Купить в 1 клик')