include ../../mixins/_mixins

section.section.section--padding-top-none.section--specs
   .section__wrapper
      .section__content
         .specs
            .bg-image
               img(src="images/specs/specs-bg.jpg", alt="фоновая картинка")
            .specs__inner.container
               +breadcrumbs([
                  { href: '#', title: 'Главная' },
                  { href: '#', title: 'Рекламодателям' }
               ])
               .specs__header
                  h1.specs__title Рекламодателям
               .specs__box
                  .specs__img
                     img(src="images/specs/specs-02.png", alt="Business Excellence" width="310" height="428")
                  .specs__info
                     h2.specs__caption Business Excellence
                     ul.specs__table
                        li #[span Формат] : 170×240 мм
                        li #[span Цветность] : 4+4
                        li #[span Объем] : 104+ страницы
                        li #[span Периодичность] : 12 выпусков в год
                        li #[span География присутствия] : Россия и страны ЕАЭС
                     .specs__manage
                        +button-icon('link', 'Скачать медиа-кит', 'button--wide')
                        +button-outline('link', 'Скачать прайс-лист')