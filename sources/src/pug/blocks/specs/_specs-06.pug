include ../../mixins/_mixins

section.section.section--specs
   .section__wrapper
      .section__content
         .specs.specs--2.specs--3
            .bg-image
               +picture("images/global/global-bg.jpg", "images/global/global-bg-mob.jpg", "фоновая картинка", 1920, 640)
            .specs__inner.container
               .specs__box
                  .specs__img
                     img(src="images/specs/specs-06.png", alt="Бизнес-план — стань хозяином своего дела")
                  .specs__info
                     p.specs__lead Название подборки
                     h2.specs__name.specs__name--large #{'Бизнес-план — '}
                        |
                        | стань хозяином своего дела
                     .specs__manage
                        p.specs__price 1 900 руб.
                        .specs__manage-box
                           +button-icon('link', 'В корзину', 'button--wide', 'icon-cart')
                           +favorite-button()