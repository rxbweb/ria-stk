section.section.section--details
      .section__wrapper.container
         .section__header
            .section__header-row
               h2.section__header-title Мероприятия
               a.section__header-button.button.button--icon(href="#")
                  span Посмотреть все мероприятия
                  i.icon.icon-arrow-small
         .section__content
            .details
               .details__inner
                  ul.details__list
                     li.details__list-item
                        a.details__list-box(href="#")
                           .details__list-img
                              img(src="images/details/details-01.jpg", alt="Общероссийская общественная премия «Стандартизатор года — 2024»" width="520" height="292")
                           .details__list-info
                              h3.details__list-title.title.title--second Общероссийская общественная премия «Стандартизатор года — 2024»
                              .details__list-text
                                 p Место проведения: Город, Адрес, улица номер дома зала или офиса.
                              .details__list-tags.tags
                                 .tags__button(href="#") Тег мероприятия: например выставка
                              p.details__list-description.title.title--third 29 октября – #[br] 6 ноября 2024
                              .details__list-button.button.button--outline
                                 span Подробнее
                                 i.icon.icon-arrow-small
                     li.details__list-item
                        a.details__list-box(href="#")
                           .details__list-img
                              img(src="images/details/details-02.jpg", alt="Форум «Российская неделя стандартизации»" width="520" height="292")
                           .details__list-info
                              h3.details__list-title.title.title--second Форум «Российская неделя стандартизации»
                              .details__list-text
                                 p Место проведения: Город, Адрес, улица номер дома зала или офиса.
                              .details__list-tags.tags
                                 .tags__button Тег мероприятия: например выставка
                              p.details__list-description.title.title--third 14 октября – #[br] 21 октября 2024
                              .details__list-button.button.button--outline
                                 span Подробнее
                                 i.icon.icon-arrow-small
                     li.details__list-item
                        a.details__list-box(href="#")
                           .details__list-img
                              img(src="images/details/details-03.jpg", alt="Форум «Лучший опыт для лучшей жизни»" width="520" height="292")
                           .details__list-info
                              h3.details__list-title.title.title--second Форум «Лучший опыт для лучшей жизни»
                              .details__list-text
                                 p Место проведения: Город, Адрес, улица номер дома зала или офиса.
                              .details__list-tags.tags
                                 .tags__button Тег мероприятия: например выставка
                              p.details__list-description.title.title--third 10 августа 2024
                              .details__list-button.button.button--outline
                                 span Подробнее
                                 i.icon.icon-arrow-small

         .section__footer
            a.section__footer-button.button.button--icon(href="#")
               span Посмотреть все мероприятия
               i.icon.icon-arrow-small