include ../../../mixins/_mixins

mixin ticketTable()   
   .ticket__table
      .ticket__table-row
         .ticket__table-col
            p.ticket__table-detail Количество статей
            p.ticket__table-primary 5 статей
         .ticket__table-col
            p.ticket__table-detail Длительность доступа
            p.ticket__table-primary 1 месяц
         .ticket__table-col
            p.ticket__table-detail Цена
            p.ticket__table-primary 700 руб.
         .ticket__table-col
            +button('В корзину', 'button--icon', 'icon-cart')
      .ticket__table-row
         .ticket__table-col
            p.ticket__table-detail Количество статей
            p.ticket__table-primary 10 статей
         .ticket__table-col
            p.ticket__table-detail Длительность доступа
            p.ticket__table-primary 3 месяца
         .ticket__table-col
            p.ticket__table-detail Цена
            p.ticket__table-primary 1000 руб.
         .ticket__table-col
            +button('В корзину', 'button--icon', 'icon-cart')
      .ticket__table-row
         .ticket__table-col
            p.ticket__table-detail Количество статей
            p.ticket__table-primary Неограничено
         .ticket__table-col
            p.ticket__table-detail Длительность доступа
            p.ticket__table-primary 1 год
         .ticket__table-col
            p.ticket__table-detail Цена
            p.ticket__table-primary 30 000 руб.
         .ticket__table-col
            +button('В корзину', 'button--icon', 'icon-cart')