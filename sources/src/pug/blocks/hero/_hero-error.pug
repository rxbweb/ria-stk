   const heroMagazines02 = [
      {
         src: "images/hero/hero-slider-01.png",
         title: "стандарты и качество"
      },
      {
         src: "images/hero/hero-slider-02.png",
         title: "методы менеджмента качества"
      },
      {
         src: "images/hero/hero-slider-03.png",
         title: "контроль качества и продукции"
      },
      {
         src: "images/hero/hero-slider-04.png",
         title: "мир измерений"
      },
      {
         src: "images/hero/hero-slider-05.png",
         title: "business excellence"
      },
      {
         src: "images/hero/hero-slider-06.png",
         title: "МКМ"
      },
      {
         src: "images/hero/hero-slider-01.png",
         title: "стандарты и качество"
      },
      {
         src: "images/hero/hero-slider-02.png",
         title: "методы менеджмента качества"
      },
   ]

section.section.section--hero
   .section__wrapper
      .section__content.container
         .hero.hero--secondary
            .bg-image
               +picture-simple("images/hero/hero-bg.jpg", "images/hero/hero-bg-mob.jpg", "фоновая картинка", 1920, 750)
            .hero__inner
               .hero__slideshow
                  .hero__row
                     .hero__info
                        h1.hero__title.hero__title--large Ошибка 404
                        .hero__text.hero__text--large
                           p Страница, которую вы запрашиваете, не существует. Возможно, она была удалена, или вы набрали неверный адрес. Перейдите на главную страницу и попробуйте найти необходимую информацию там.
                        .hero__bottom
                           +button-icon('link', 'Вернуться на главную')
                     .hero__content
                        .hero__magazines
                           .hero__magazines-block
                              .hero__magazines-col
                                 each magazine in heroMagazines02
                                    .hero__magazines-card
                                       img(src=magazine.src, alt=magazine.title width="362")
                           .hero__magazines-block
                              .hero__magazines-col.hero__magazines-col--reverse
                                 each magazine in heroMagazines02
                                    .hero__magazines-card
                                       img(src=magazine.src, alt=magazine.title width="362")
                        .hero__journals
                           .hero__journals-row
                              each magazine in heroMagazines02
                                 .hero__journals-card
                                    img(src=magazine.src, alt=magazine.title width="362")