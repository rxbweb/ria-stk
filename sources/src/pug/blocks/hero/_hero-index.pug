-
   const heroMagazines01 = [
      {
         src: "images/hero/hero-slider-01.png",
         title: "стандарты и качество"
      },
      {
         src: "images/hero/hero-slider-02.png",
         title: "методы менеджмента качества"
      },
      {
         src: "images/hero/hero-slider-03.png",
         title: "контроль качества и продукции"
      },
      {
         src: "images/hero/hero-slider-04.png",
         title: "мир измерений"
      },
      {
         src: "images/hero/hero-slider-05.png",
         title: "business excellence"
      },
      {
         src: "images/hero/hero-slider-06.png",
         title: "МКМ"
      },
      {
         src: "images/hero/hero-slider-06.png",
         title: "МКМ"
      }
   ]

section.section.section--hero.section--padding-none
   .section__wrapper
      .section__content
         .hero
            .bg-image
               img(src="images/hero/hero-bg.jpg", alt="фоновая картинка" width="1920" height="750")
            .hero__inner.container
                  .hero__slider
                     .swiper-wrapper
                        - for (let i = 0; i < 4; i++)
                           .swiper-slide
                              .hero__row
                                 .hero__info
                                    h1.hero__title Качество информации – наш стандарт
                                    .hero__text
                                       p РИА «Стандарты и качество» — лидер рынка профессиональных периодических изданий для специалистов в области технического регулирования, стандартизации, обеспечения единства измерений и управления качеством, организатор деловых мероприятий, информационно-просветительский центр Всероссийской организации качества.
                                    .hero__bottom
                                       include ../button/_button.pug
                                       +button('Узнать больше', 'button--icon', 'icon-arrow-small')
                                 .hero__content
                                    .hero__books
                                       .hero__books-inner
                                          .hero__books-content
                                             .hero__books-swiper
                                                .swiper-wrapper
                                                   each magazine in heroMagazines01
                                                      .swiper-slide.hero__books-slide
                                                         .hero__books-figure
                                                            img(src=magazine.src, alt=magazine.title width="396" height="512")
                                                            .hero__books-name= magazine.title
                                                .hero__books-controls
                                                   .js-books-pagination-current
                                                   .js-books-pagination.swiper-pagination
                                                   .js-books-pagination-total
                     .swiper-bullets.js-hero-bullets.hero__slider-bullets