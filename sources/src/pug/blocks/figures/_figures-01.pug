section.section.section--figures
   .section__wrapper.container
      .section__header.section__header--border
         .section__header-row
            h2.section__header-title Научные статьи из журналов
      .section__content
         .figures
            .figures__inner
               ul.figures__list
                  each figure in figures01
                     li.figures__item
                        a.figures__box(href="#")
                           .figures__svg
                              img(src=figure.src, alt="иконка" width="100" height="100")
                              img(src=`${figure.src.replace('.svg', '-hover.svg')}`, alt="иконка" width="100" height="100")
                           .figures__info
                              p.figures__text= figure.text