.sidebar
   .sidebar__inner
      .sidebar__main
         .sidebar__list
            each button, index in ['О журнале', 'Подписка', 'Реклама', 'Архив', 'Отзывы', 'Отправить статью', 'Редакционная политика', 'Правила для авторов', 'Рецензирование', 'Редакция', 'Редсоветы', 'Авторы']
               a.sidebar__button(href="#")
                  .sidebar__icon
                     svg
                        use(href=`images/sprites/main.stack.svg#svg-sidebar-${(index + 1).toString().padStart(2, '0')}`)
                  .sidebar__text=button